---
// "✨ 12,408 readings completed so far". The number comes from /api/counter
// (functions/api/counter.ts), which only runs once the site is live on Cloudflare.
// Until then, a gentle message shows instead of a number.
---

<p class="counter" aria-live="polite"><span aria-hidden="true">✨</span> <span data-counter-text>Free readings, forever</span></p>

<style>
  .counter { margin: 0; font-size: 0.82rem; color: var(--mist); letter-spacing: 0.02em; white-space: nowrap; }
  .counter :global(strong) { color: var(--gold); font-weight: 600; }
</style>

<script>
  const el = document.querySelector<HTMLElement>("[data-counter-text]");
  fetch("/api/counter")
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((d: { count: number }) => {
      if (el && typeof d.count === "number" && d.count > 0) {
        el.innerHTML = `<strong>${d.count.toLocaleString("en-GB")}</strong> readings completed so far`;
      }
    })
    .catch(() => {});
</script>
