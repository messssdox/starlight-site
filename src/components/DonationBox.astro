---
// The small, elegant donation box. All settings live in src/config/donations.ts.
import { DONATIONS } from "../config/donations.ts";
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---

<section class:list={["donate", "panel", { compact }]} aria-labelledby="donate-title" data-provider={DONATIONS.provider ?? ""} data-link={DONATIONS.link}>
  <p class="eyebrow">Free forever</p>
  <h2 id="donate-title">Support Starlight</h2>
  <p class="message">{DONATIONS.message}</p>
  <form class="amounts" aria-label="Choose an amount">
    {DONATIONS.amounts.map((a, i) => (
      <label class="chip">
        <input type="radio" name="amount" value={a} checked={i === 1} />
        <span>{DONATIONS.symbol}{a}</span>
      </label>
    ))}
    <label class="chip other">
      <input type="radio" name="amount" value="other" />
      <span>Other</span>
    </label>
    <div class="custom" hidden>
      <label for="custom-amount">Your amount ({DONATIONS.symbol})</label>
      <input id="custom-amount" type="number" min="1" step="1" inputmode="numeric" placeholder="15" />
    </div>
    <button class="btn" type="submit">Give with gratitude ✦</button>
  </form>
  <p class="thanks muted" hidden></p>
</section>

<style>
  .donate { max-width: 560px; margin: 0 auto; text-align: center; }
  .message { color: var(--mist); font-family: var(--font-reading); font-size: 1.15rem; line-height: 1.55; }
  .amounts { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 18px; }
  .chip { margin: 0; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .chip span { display: inline-block; min-width: 64px; padding: 0.55em 1em; border-radius: 999px; border: 1px solid rgba(212, 175, 90, 0.5); color: var(--moonlight); font-size: 1rem; transition: all 0.2s; }
  .chip input:checked + span { background: rgba(212, 175, 90, 0.18); border-color: var(--gold); color: var(--gold); }
  .chip input:focus-visible + span { outline: 2px solid var(--orchid); outline-offset: 2px; }
  .custom { width: 100%; max-width: 200px; margin: 4px auto 0; text-align: left; }
  .amounts .btn { width: 100%; max-width: 280px; justify-content: center; margin-top: 8px; }
  .thanks { margin-top: 14px; }
  .compact h2 { font-size: 1.3rem; }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".donate").forEach((box) => {
    const form = box.querySelector("form")!;
    const custom = box.querySelector<HTMLElement>(".custom")!;
    const thanks = box.querySelector<HTMLElement>(".thanks")!;
    form.addEventListener("change", () => {
      custom.hidden = (form.querySelector<HTMLInputElement>("input[name=amount]:checked")?.value ?? "") !== "other";
    });
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const picked = form.querySelector<HTMLInputElement>("input[name=amount]:checked")?.value;
      const amount = picked === "other" ? box.querySelector<HTMLInputElement>("#custom-amount")!.value : picked;
      const { provider, link } = box.dataset;
      if (!provider || !link) {
        thanks.textContent = "Thank you so much for wanting to help. Donations open very soon ✨";
        thanks.hidden = false;
        return;
      }
      // Ko-fi and PayPal let the visitor confirm the amount on their page; Stripe Payment Links can pre-fill it.
      const url = new URL(link);
      if (provider === "stripe" && amount) url.searchParams.set("__prefilled_amount", String(Number(amount) * 100));
      window.open(url.toString(), "_blank", "noopener");
    });
  });
</script>
