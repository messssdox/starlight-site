---
// The entry form on the homepage. The more someone shares, the deeper the reading.
import { RELATIONSHIPS, RELATIONSHIP_GROUPS } from "../data/relationships.ts";
import BirthDate from "./BirthDate.astro";
const tiers = [
  { id: "glance", name: "Quick Glance", text: "Just the essence and your key traits." },
  { id: "first", name: "First Timers", text: "A friendly, gentle introduction, with everything explained." },
  { id: "deep", name: "Full Deep Dive", text: "Comprehensive and detailed, with all the working shown." },
];
---

<form class="reading-form panel" action="/reading" method="get">
  <div class="grid">
    <div>
      <label for="f-name">Your name</label>
      <input id="f-name" name="n" autocomplete="name" placeholder="e.g. Jamie Taylor" required />
    </div>
    <BirthDate id="f-date" name="d" label="Your birth date" required />
  </div>

  <section class="compat-box" data-compat>
    <button type="button" class="compat-open" id="compat-title" data-compat-open aria-expanded="false" aria-controls="compat-body">
      <span>Add someone for a compatibility reading</span><span class="plus" aria-hidden="true">＋</span>
    </button>
    <div class="compat-body" id="compat-body" data-compat-body>
    <small>Pick who they are to you and you will get a reading of the two of you together.</small>
    <div class="rel-list" data-rel-list role="radiogroup" aria-labelledby="compat-title">
      {RELATIONSHIP_GROUPS.map((g) => (
        <div class="rel-group">
          <span class="rel-g">{g}</span>
          <div class="rel-chips">
            {Object.entries(RELATIONSHIPS).filter(([, r]) => r.group === g).map(([id, r]) => (
              <label class="rel-chip"><input type="radio" name="rel" value={id} data-label={r.label} /><span>{r.label}</span></label>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="rel-chosen" data-rel-chosen hidden>
      <span>Compatibility with: <strong data-rel-label></strong></span>
      <button type="button" class="link-btn" data-rel-change>Change</button>
      <button type="button" class="link-btn" data-rel-clear>Remove</button>
    </div>
    <div class="compat-fields" data-compat-fields>
      <p class="their-head">Their details</p>
      <div class="grid">
        <div>
          <label for="f-name2">Their first name (optional)</label>
          <input id="f-name2" name="n2" placeholder="e.g. Alex" />
        </div>
        <BirthDate id="f-date2" name="d2" label="Their birth date" />
      </div>
    </div>
    </div>
  </section>

  <fieldset class="tiers">
    <legend>How deep would you like to go?</legend>
    {tiers.map((t, i) => (
      <label class="tier">
        <input type="radio" name="tier" value={t.id} checked={i === 1} />
        <span><strong>{t.name}</strong><small>{t.text}</small></span>
      </label>
    ))}
  </fieldset>

  <button class="btn" type="submit">Reveal my reading ✦</button>
</form>

<style>
  .reading-form { display: grid; gap: 18px; }
  .compat-box { border: 1px solid rgba(212, 175, 90, 0.45); border-radius: 14px; padding: 14px 16px; background: rgba(212, 175, 90, 0.06); display: grid; gap: 10px; }
  .compat-open { display: flex; justify-content: space-between; align-items: center; gap: 12px; width: 100%; background: none; border: 0; padding: 0; text-align: left; cursor: pointer; color: var(--gold); font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; }
  .compat-open .plus { font-size: 1.2rem; transition: transform 0.2s; }
  .compat-open[aria-expanded="true"] .plus { transform: rotate(45deg); }
  .compat-open:focus-visible { outline: 2px solid var(--orchid); outline-offset: 4px; }
  .compat-body { display: grid; gap: 10px; }
  .compat-body > small { color: var(--mist); font-size: 0.82rem; }
  .rel-list { display: grid; gap: 8px; }
  .rel-group { display: grid; grid-template-columns: 4.5rem 1fr; gap: 8px; align-items: baseline; }
  .rel-g { color: var(--mist); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; }
  .rel-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .rel-chip { margin: 0; cursor: pointer; }
  .rel-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .rel-chip span { display: inline-block; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(142, 107, 217, 0.45); font-size: 0.88rem; color: var(--moonlight); transition: all 0.15s; }
  .rel-chip span:hover { border-color: var(--gold); }
  .rel-chip input:checked + span { border-color: var(--gold); background: rgba(212, 175, 90, 0.18); color: var(--gold); }
  .rel-chip input:focus-visible + span { outline: 2px solid var(--orchid); outline-offset: 2px; }
  .rel-chosen { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .rel-chosen strong { color: var(--gold); }
  .link-btn { background: none; border: 0; padding: 0; color: var(--orchid); font: inherit; font-size: 0.9rem; text-decoration: underline; cursor: pointer; }
  .compat-fields { display: grid; gap: 14px; padding-top: 14px; border-top: 1px dashed rgba(212, 175, 90, 0.5); scroll-margin: 90px; }
  .their-head { margin: 0; font-family: var(--font-display); color: var(--gold); font-size: 1rem; }
  .compat-fields[hidden], .rel-chosen[hidden], .rel-list[hidden], .tiers[hidden], .compat-body[hidden] { display: none; }
  .tiers { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .tiers legend { font-family: var(--font-display); color: var(--gold); margin-bottom: 10px; font-size: 1.05rem; }
  .tier { margin: 0; cursor: pointer; }
  .tier input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tier span { display: grid; gap: 4px; height: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(142, 107, 217, 0.4); transition: all 0.2s; }
  .tier strong { color: var(--moonlight); font-weight: 600; }
  .tier small { color: var(--mist); font-size: 0.82rem; line-height: 1.4; }
  .tier input:checked + span { border-color: var(--gold); background: rgba(212, 175, 90, 0.1); box-shadow: 0 0 20px rgba(212, 175, 90, 0.15); }
  .tier input:focus-visible + span { outline: 2px solid var(--orchid); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .btn { justify-self: start; }
  @media (max-width: 720px) {
    .tiers, .grid { grid-template-columns: 1fr; }
    .rel-group { grid-template-columns: 1fr; gap: 4px; }
  }
</style>

<script>
  // The compatibility box starts as one line. Tapping it opens the relationship choices;
  // picking one folds the list away and shows the second person's fields, which are only
  // sent, and only required, once someone is chosen.
  const box = document.querySelector<HTMLElement>("[data-compat]");
  if (box) {
    const opener = box.querySelector<HTMLButtonElement>("[data-compat-open]")!;
    const body = box.querySelector<HTMLElement>("[data-compat-body]")!;
    const list = box.querySelector<HTMLElement>("[data-rel-list]")!;
    const chosen = box.querySelector<HTMLElement>("[data-rel-chosen]")!;
    const fields = box.querySelector<HTMLElement>("[data-compat-fields]")!;
    const radios = [...box.querySelectorAll<HTMLInputElement>('input[name="rel"]')];
    let open = false;
    let changing = false;
    const sync = () => {
      const picked = radios.find((r) => r.checked);
      if (picked) open = true;
      opener.setAttribute("aria-expanded", String(open));
      body.hidden = !open;
      list.hidden = !!picked && !changing;
      chosen.hidden = !picked || changing;
      fields.hidden = !picked;
      // a relationship reading comes in one full version, so the depth choice steps aside
      const tiers = document.querySelector<HTMLElement>(".reading-form .tiers");
      if (tiers) {
        tiers.hidden = !!picked;
        for (const t of tiers.querySelectorAll("input")) t.disabled = !!picked;
      }
      box.querySelector<HTMLElement>("[data-rel-label]")!.textContent = picked?.dataset.label ?? "";
      for (const el of fields.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input, select")) {
        // only the named fields are sent; the date lists stay enabled so the browser can
        // refill them after the Back button
        if (el.name) el.disabled = !picked;
        if (el.closest("[data-birthdate]")) el.required = !!picked && el.type !== "hidden";
      }
    };
    opener.addEventListener("click", () => {
      open = !open;
      if (!open) for (const r of radios) r.checked = false;
      changing = false;
      sync();
    });
    // picking someone folds the list away, which can leave their fields off screen on a phone, so bring them into view
    const showFields = () => fields.scrollIntoView({ behavior: "smooth", block: "nearest" });
    for (const r of radios) r.addEventListener("change", () => { changing = false; sync(); showFields(); });
    box.querySelector("[data-rel-change]")!.addEventListener("click", () => { changing = true; sync(); });
    box.querySelector("[data-rel-clear]")!.addEventListener("click", () => {
      for (const r of radios) r.checked = false;
      open = false;
      changing = false;
      sync();
    });
    window.addEventListener("pageshow", () => sync());
    sync();
  }

  // On a phone, the keyboard's next arrow walks through every field on the page, so after the last
  // date list here it would carry on down to "Find your sign and animal" and send the second person's
  // details into the wheel's date. Those lists stay tappable but are left out of that walk on touch screens.
  if (matchMedia("(pointer: coarse)").matches) {
    for (const el of document.querySelectorAll<HTMLElement>(".finder select")) el.tabIndex = -1;
  }
</script>
