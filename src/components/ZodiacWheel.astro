---
// The interactive Chinese zodiac wheel, laid out like the original hand-drawn wheel.
// Rings, from the outside in:
//   1. the outer edge: the four season elements (Water, Wood, Fire, Metal) and the animals' numbers 1 to 12
//   2. the 12 animals, each with its gold medallion and name, coloured by friend group (same colour = friends)
//   3. the inner colour ring: secret friends share a colour
//   4. the years, newest on the outside, every 12 years further in
// Directly opposite animals clash. Beside it sits the sun sign wheel in the same style: the seasons on the edge,
// the dates, the 12 signs coloured by element (same colour = friends) and their ruling planets.
// Show me spins both wheels to the reader's sign and animal and reveals one reading for the pair
// ("The Cancer Horse"): the profile and forecast in the panel, and the pair's friends, secret friend
// and clash in the three boxes. Tapping any sign or animal afterwards changes the pair.
import BirthDate from "./BirthDate.astro";
import { ANIMALS, SECRET_FRIENDS, SEASONS, ELEMENTS, EARTH_ANIMALS } from "../data/zodiac.ts";
import { SIGNS, PLANETS } from "../data/astrology.ts";
import { SIGN_PARTS, SIGN_ELEMENT_COLOURS, SIGN_SEASONS } from "../data/pairs.ts";
import { topArc, bottomArc, pillArc, arcId } from "../lib/arc.ts";

const R = {
  centre: 54,
  yearsIn: 58, yearsOut: 242,
  secretIn: 246, secretOut: 278,
  animalIn: 282, animalOut: 430,
  numIn: 432, numOut: 458,
  rimIn: 458, rimOut: 492,
};
const YEAR_ROW_GAP = 20;
const YEAR_ROWS = 9; // 9 rows of 12 years reach back to the 1920s
const rad = (deg: number) => (deg * Math.PI) / 180;
const angleOf = (i: number) => -90 + i * 30;
const pt = (i: number, r: number) => [r * Math.cos(rad(angleOf(i))), r * Math.sin(rad(angleOf(i)))].map((v) => +v.toFixed(2));
/** Rotation that lays text along the ring, flipped on the lower half so nothing is upside down. The script redoes this as the wheel turns. */
const along = (i: number) => {
  const a = angleOf(i);
  return Math.sin(rad(a)) > 0.01 ? a - 90 : a + 90;
};
/** Attributes for a label curved along the ring at segment position i. Its letters run on one of the wheel's
 *  shared arcs (see `tp`); this turns that arc to the segment. The script redoes it as the wheel turns. */
const tt = (i: number) => ({ "data-i": i, "data-x": 0, "data-y": 0, transform: `rotate(${along(i)})` });
/** The arcs each wheel's labels use, keyed by radius, drawn once in that wheel's <defs>. */
const arcs: Record<string, Set<number>> = { aw: new Set(), sw: new Set() };
/** Attributes for the <textPath> of a label at ring radius r on `wheel`. `dy` moves the letters' baseline so they sit
 *  centred on the ring: inwards on the top half (letters point out), outwards on the bottom half (letters point in). */
const tp = (wheel: "aw" | "sw", i: number, r: number, dy: number) => {
  const top = arcId(wheel, r - dy, "t"), bot = arcId(wheel, r + dy, "b");
  arcs[wheel].add(r - dy).add(r + dy);
  return { href: `#${Math.sin(rad(angleOf(i))) > 0.01 ? bot : top}`, "data-top": top, "data-bot": bot, startOffset: "50%" };
};
/** A curved pill behind a label: `w` and `h` are the straight pill's width and height. */
const pill = (i: number, r: number, w: number, h: number) => pillArc(r, angleOf(i), w - h);

function wedge(i: number, r0: number, r1: number, span = 1) {
  const a0 = rad(angleOf(i) - 15), a1 = rad(angleOf(i) - 15 + 30 * span);
  const p = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  return `M${p(r1, a0)} A${r1} ${r1} 0 0 1 ${p(r1, a1)} L${p(r0, a1)} A${r0} ${r0} 0 0 0 ${p(r0, a0)} Z`;
}

const secretColour = (id: string) => SECRET_FRIENDS.find((s) => s.pair.includes(id))!.colour;

/** The newest year shown for each animal: the window 2019 (Pig) to 2030 (Dog), as on the drawn wheel. */
const topYear = (i: number) => 2019 + ((i - 11 + 12) % 12);
const yearLabel = (y: number, row: number) => (row < 3 ? String(y) : String(y).slice(2));

/** The sign wheel's rings, from the centre out. */
const S = { centre: 54, planetOut: 246, signIn: 250, signOut: 424, dateIn: 424, dateOut: 452, rimIn: 452, rimOut: 492 };
const RULER_GLYPH: Record<string, string> = Object.fromEntries(PLANETS.map((p) => [p.name, p.glyph]));
const rulerName = (r: string) => r.replace(/^the /, "");
/** Width of the cream label behind a name. */
const tagW = (name: string) => name.length * 15.5 + 22;
---

<section class="wheel-wrap" aria-labelledby="wheel-title">
  <div class="finder-head">
    <p class="eyebrow">The sun sign and Chinese zodiac wheels</p>
    <h2 id="wheel-title">Find your sign and animal</h2>
    <form class="finder" autocomplete="off">
      <BirthDate id="wheel-date" name="date" label="Your birth date" />
      <label class="sign-pick">
        <span>Your sun sign</span>
        <select id="wheel-sign" name="sign">
          {SIGNS.map((g) => <option value={g.id}>{`${g.glyph} ${g.name}`}</option>)}
        </select>
      </label>
      <button class="btn" type="submit">Show me</button>
    </form>
  </div>

  <div class="wheels">
    <div class="wheel-col">
      <button type="button" class="zoom-btn" data-zoom="animal" aria-label="Enlarge the Chinese zodiac wheel">⤢ Enlarge</button>
      <svg class="wheel" viewBox="-500 -520 1000 1020" role="group" aria-label="The Chinese zodiac wheel" style="--spin: 0deg">
      <defs>
        {ANIMALS.map((a) => (
          <radialGradient id={`g-${a.id}`} gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R.animalOut}>
            <stop offset="0.64" stop-color={a.colour} stop-opacity="0.85" />
            <stop offset="1" stop-color={a.colour} />
          </radialGradient>
        ))}
        <radialGradient id="g-paper" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R.yearsOut}>
          <stop offset="0" stop-color="#ece5d6" />
          <stop offset="1" stop-color="#faf6ee" />
        </radialGradient>
        <filter id="lift" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#1d1729" flood-opacity="0.45" />
        </filter>
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="7" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>

      <g class="rot">
        <!-- outer edge: the four seasons and their elements, plus Earth at the turn of each season. Tap one for its meaning. -->
        <g class="rim">
          {SEASONS.map((s) => {
            const first = ANIMALS.find((a) => a.id === s.animals[0])!.index;
            const mid = ANIMALS.find((a) => a.id === s.animals[1])!;
            return (
              <g class="season elem" data-element={s.element} tabindex="0" role="button" aria-label={`${s.element}: what this element means`}>
                <path class="band" d={wedge(first, R.rimIn, R.rimOut, 3)} fill={s.colour} />
                <text class="season-name tt" {...tt(mid.index)} text-anchor="middle"><textPath {...tp("aw", mid.index, (R.rimIn + R.rimOut) / 2, 8)}>{`${ELEMENTS[s.element].glyph} ${s.element.toUpperCase()}`}</textPath></text>
                <path class="elem-outline" d={wedge(first, R.rimIn, R.rimOut, 3)} />
              </g>
            );
          })}
          {EARTH_ANIMALS.map((id) => {
            const a = ANIMALS.find((x) => x.id === id)!;
            return (
              <g class="earth-pill elem" data-element="Earth" tabindex="0" role="button" aria-label="Earth: what this element means">
                <path class="pill-edge" d={pill(a.index, (R.rimIn + R.rimOut) / 2, 116, 30)} />
                <path class="pill" d={pill(a.index, (R.rimIn + R.rimOut) / 2, 116, 30)} />
                <text class="tt" {...tt(a.index)} text-anchor="middle"><textPath {...tp("aw", a.index, (R.rimIn + R.rimOut) / 2, 6)}>土 EARTH</textPath></text>
              </g>
            );
          })}
        </g>

        <!-- the 12 animal segments: number band, animal ring and secret-friend ring -->
        {ANIMALS.map((a) => {
          const [ix, iy] = pt(a.index, 354);
          return (
            <g class="seg" data-id={a.id} tabindex="0" role="button" aria-label={`${a.name}: turn the wheel to the ${a.name}`}>
              <path class="num-band" d={wedge(a.index, R.numIn, R.numOut)} />
              <text class="num tt" {...tt(a.index)} text-anchor="middle"><textPath {...tp("aw", a.index, (R.numIn + R.numOut) / 2, 7)}>{a.index + 1}</textPath></text>
              <path class="animal" d={wedge(a.index, R.animalIn, R.animalOut)} fill={`url(#g-${a.id})`} />
              <path class="secret" d={wedge(a.index, R.secretIn, R.secretOut)} fill={secretColour(a.id)} />
              <g transform={`translate(${ix} ${iy})`}><g class="upright">
                <image class="render" href={`/animals/${a.id}.png`} x="-40" y="-40" width="80" height="80" filter="url(#lift)" />
              </g></g>
              <g class="name-tag"><path class="pill-edge" d={pill(a.index, 408, tagW(a.name), 32)} /><path class="pill" d={pill(a.index, 408, tagW(a.name), 32)} /><text class="name tt" {...tt(a.index)} text-anchor="middle"><textPath {...tp("aw", a.index, 408, 8)}>{a.name.toUpperCase()}</textPath></text></g>
              <g class="badge" data-r="300" data-angle={angleOf(a.index)} aria-hidden="true">
                <path class="pill-edge" />
                <path class="pill" />
                <text class="tt" {...tt(a.index)} text-anchor="middle"><textPath {...tp("aw", a.index, 300, 6)}></textPath></text>
              </g>
              <path class="outline" d={wedge(a.index, R.secretIn, R.numOut)} />
            </g>
          );
        })}

        <!-- the years: newest on the outside, 12 years further back on each row inwards -->
        <g class="years">
          <circle r={R.yearsOut} fill="url(#g-paper)" />
          {ANIMALS.map((a) => (
            <g class="year-col" data-for={a.id}>
              {Array.from({ length: YEAR_ROWS }, (_, row) => {
                const y = topYear(a.index) - 12 * row;
                const r = R.yearsOut - 12 - row * YEAR_ROW_GAP;
                return (
                  <g class="year" data-year={y} data-id={a.id} role="button" aria-label={`${y}, year of the ${a.name}`}>
                    <path class="cell" d={wedge(a.index, r - YEAR_ROW_GAP / 2, r + YEAR_ROW_GAP / 2)} />
                    <text class="tt" {...tt(a.index)} text-anchor="middle"><textPath {...tp("aw", a.index, r, 6)}>{yearLabel(y, row)}</textPath></text>
                  </g>
                );
              })}
            </g>
          ))}
          {ANIMALS.map((a) => {
            const [x1, y1] = pt(a.index - 0.5, R.centre);
            const [x2, y2] = pt(a.index - 0.5, R.yearsOut);
            return <line class="spoke" x1={x1} y1={y1} x2={x2} y2={y2} aria-hidden="true" />;
          })}
        </g>

        <!-- ink lines between rings, like the drawn wheel -->
        <g class="ink" aria-hidden="true" pointer-events="none">
          {[R.yearsOut, R.secretIn, R.secretOut, R.animalIn, R.animalOut, R.numOut, R.rimOut].map((r) => <circle r={r} />)}
          {ANIMALS.map((a) => {
            const [x1, y1] = pt(a.index - 0.5, R.secretIn);
            const [x2, y2] = pt(a.index - 0.5, R.numOut);
            return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
          })}
        </g>
      </g>

      <!-- the selected animal: the gold marker at the top stays still while the wheel turns -->
      <g class="marker" aria-hidden="true" pointer-events="none">
        <path d="M-26 -518 L26 -518 L0 -486 Z" />
      </g>

      <g class="centre" aria-hidden="true" pointer-events="none">
        <circle r={R.centre} />
        <image class="centre-img" href="/animals/rat.png" x="-46" y="-46" width="92" height="92" />
        <text class="centre-glyph" y="20" text-anchor="middle"></text>
      </g>
      <defs>{[...arcs.aw].map((r) => [<path id={arcId("aw", r, "t")} d={topArc(r)} />, <path id={arcId("aw", r, "b")} d={bottomArc(r)} />])}</defs>
    </svg>
    </div>
    <div class="wheel-col">
      <button type="button" class="zoom-btn" data-zoom="sign" aria-label="Enlarge the sun sign wheel">⤢ Enlarge</button>
      <svg class="wheel sign-wheel" viewBox="-500 -520 1000 1020" role="group" aria-label="The sun sign wheel" style="--spin: 0deg">
          <defs>
            {Object.entries(SIGN_ELEMENT_COLOURS).map(([el, c]) => (
              <radialGradient id={`gs-${el}`} gradientUnits="userSpaceOnUse" cx="0" cy="0" r={S.signOut}>
                <stop offset="0.6" stop-color={c} stop-opacity="0.85" />
                <stop offset="1" stop-color={c} />
              </radialGradient>
            ))}
          </defs>
          <g class="rot">
            <!-- outer edge: the four seasons, three signs each -->
            <g class="rim" aria-hidden="true">
              {SIGN_SEASONS.map((x) => (
                <g>
                  <path class="band" d={wedge(x.first, S.rimIn, S.rimOut, 3)} fill={x.colour} />
                  <text class="season-name tt" {...tt(x.first + 1)} text-anchor="middle"><textPath {...tp("sw", x.first + 1, (S.rimIn + S.rimOut) / 2, 8)}>{x.season.toUpperCase()}</textPath></text>
                </g>
              ))}
            </g>
            <!-- the 12 signs: date band, sign ring and ruling planet -->
            {SIGNS.map((g, i) => {
              const [mx, my] = pt(i, 330);
              return (
                <g class="seg" data-sign={g.id} tabindex="0" role="button" aria-label={`${g.name}: turn the wheel to ${g.name}`}>
                  <path class="num-band" d={wedge(i, S.dateIn, S.dateOut)} />
                  <text class="date tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, (S.dateIn + S.dateOut) / 2, 6)}>{SIGN_PARTS[g.id].dates.toUpperCase()}</textPath></text>
                  <path class="animal" d={wedge(i, S.signIn, S.signOut)} fill={`url(#gs-${g.element})`} />
                  <path class="cell" d={wedge(i, S.centre, S.planetOut)} />
                  <g transform={`translate(${mx} ${my})`}><g class="upright">
                    <circle class="medal" r="36" />
                    <text class="medal-glyph" y="14" text-anchor="middle">{g.glyph}</text>
                  </g></g>
                  <g class="name-tag"><path class="pill-edge" d={pill(i, 396, tagW(g.name), 32)} /><path class="pill" d={pill(i, 396, tagW(g.name), 32)} /><text class="name tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, 396, 8)}>{g.name.toUpperCase()}</textPath></text></g>
                  <text class="ruler-glyph tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, 206, 12)}>{RULER_GLYPH[rulerName(g.ruler)]}</textPath></text>
                  <text class="ruler-name tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, 168, 6)}>{rulerName(g.ruler).toUpperCase()}</textPath></text>
                  <text class="elem-name tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, 118, 5)}>{g.element.toUpperCase()}</textPath></text>
                  <g class="badge" data-r="280" data-angle={angleOf(i)} aria-hidden="true">
                    <path class="pill-edge" />
                    <path class="pill" />
                    <text class="tt" {...tt(i)} text-anchor="middle"><textPath {...tp("sw", i, 280, 6)}></textPath></text>
                  </g>
                  <path class="outline" d={wedge(i, S.signIn, S.dateOut)} />
                </g>
              );
            })}
            <g class="ink" aria-hidden="true" pointer-events="none">
              {[S.planetOut, S.signIn, S.signOut, S.dateOut, S.rimOut].map((r) => <circle r={r} />)}
              {SIGNS.map((_, i) => {
                const [x1, y1] = pt(i - 0.5, S.centre);
                const [x2, y2] = pt(i - 0.5, S.dateOut);
                return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
              })}
            </g>
          </g>
          <g class="marker" aria-hidden="true" pointer-events="none">
            <path d="M-26 -518 L26 -518 L0 -486 Z" />
          </g>
          <g class="centre" aria-hidden="true" pointer-events="none">
            <circle r={S.centre} />
            <text class="centre-glyph sign-centre" y="20" text-anchor="middle"></text>
          </g>
          <defs>{[...arcs.sw].map((r) => [<path id={arcId("sw", r, "t")} d={topArc(r)} />, <path id={arcId("sw", r, "b")} d={bottomArc(r)} />])}</defs>
        </svg>
    </div>
  </div>

  <dialog class="zoom" aria-label="Enlarged wheel">
    <div class="zoom-bar">
      <button type="button" data-zoom-step="-1" aria-label="Zoom out">−</button>
      <button type="button" data-zoom-step="1" aria-label="Zoom in">+</button>
      <button type="button" class="zoom-close" data-zoom-close>Close ✕</button>
    </div>
    <div class="zoom-stage" data-zoom-stage></div>
  </dialog>

  <div class="reveal" data-reveal hidden>
    <div class="reveal-boxes">
      <h3 class="select-title">Friends, secret friend and clash</h3>
      <div class="insights" data-insights>
        <div class="insight" data-kind="friends"><p class="label">Friends</p><div class="body"></div></div>
        <div class="insight" data-kind="secret"><p class="label">Secret friend</p><div class="body"></div></div>
        <div class="insight" data-kind="clash"><p class="label">Clash</p><div class="body"></div></div>
      </div>
      <p class="muted tap-note">Tap any sign, animal, year or element on the wheels to explore.</p>
    </div>
    <aside class="info panel" aria-live="polite">
      <div class="details" data-details data-glossary></div>
    </aside>
  </div>
</section>

<style>
  .finder-head { max-width: 760px; margin: 0 auto 22px; text-align: center; }
  .finder-head h2 { margin: 0 0 14px; }
  .finder { display: flex; flex-wrap: wrap; align-items: end; justify-content: center; gap: 10px 12px; text-align: left; }
  .finder :global(.birthdate) { flex: 1 1 280px; }
  .sign-pick { display: grid; gap: 0.35em; flex: 0 1 190px; }
  .sign-pick span { font-size: 0.85rem; color: var(--mist); }
  .wheels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 4vw, 56px); align-items: center; }
  .reveal { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; margin-top: clamp(20px, 3vw, 36px); animation: rise 0.6s ease-out; }
  .reveal[hidden] { display: none; }
  .tap-note { margin: 12px 0 0; font-size: 0.85rem; text-align: center; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 900px) { .wheels, .reveal { grid-template-columns: 1fr; } .wheels .wheel-col { max-width: 560px; margin: 0 auto; width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .reveal { animation: none; } }

  .wheel-col { position: relative; }
  .zoom-btn { position: absolute; top: 0; right: 0; z-index: 2; border-radius: 999px; padding: 6px 12px; font: 600 0.85rem var(--font-body); cursor: pointer; background: rgba(18, 14, 31, 0.85); color: var(--gold); border: 1px solid rgba(212, 175, 90, 0.6); }
  .zoom-btn:hover, .zoom-btn:focus-visible { background: var(--gold); color: #120e1f; }
  .zoom { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #0b0816; color: var(--moonlight); }
  .zoom::backdrop { background: rgba(0, 0, 0, 0.8); }
  .zoom-stage { display: flex; width: 100%; height: 100%; overflow: auto; padding: 64px 12px 12px; box-sizing: border-box; }
  /* opens with the whole wheel in sight; + and − change --z to make it bigger or smaller */
  .zoom-stage :global(svg) { --fit: min(calc(100vw - 24px), calc(100dvh - 76px)); width: calc(var(--fit) * var(--z, 1)); max-width: none; height: auto; margin: auto; flex-shrink: 0; }
  .zoom-bar { position: fixed; top: 12px; right: 12px; z-index: 3; display: flex; gap: 8px; }
  .zoom-bar button { border-radius: 999px; min-width: 44px; padding: 8px 14px; font: 700 1rem var(--font-body); cursor: pointer; background: rgba(18, 14, 31, 0.9); color: var(--gold); border: 1px solid var(--gold); }
  .zoom-bar .zoom-close { background: var(--gold); color: #120e1f; }
  .zoom-bar button:disabled { opacity: 0.4; cursor: default; }
  .wheel { width: 100%; height: auto; display: block; overflow: visible; filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.55)); }
  .wheel text { pointer-events: none; }
  .wheel .rot { transform: rotate(var(--spin)); transition: transform 1.5s cubic-bezier(0.65, 0, 0.35, 1); }
  .wheel .upright { transform: rotate(calc(-1 * var(--spin))); transition: transform 1.5s cubic-bezier(0.65, 0, 0.35, 1); }
  .wheel.no-anim .rot, .wheel.no-anim .upright { transition: none; }
  @media (prefers-reduced-motion: reduce) { .wheel .rot, .wheel .upright { transition: none; } }

  .sign-wheel .cell { fill: #faf6ee; transition: fill 0.3s; }
  .sign-wheel .seg.is-self .cell { fill: #f1e2b8; }
  .sign-wheel .date { font: 700 17px var(--font-body); fill: #120e1f; letter-spacing: 0.02em; }
  .sign-wheel .medal { fill: #120e1f; stroke: #d4af5a; stroke-width: 3; filter: url(#lift); }
  .sign-wheel .medal-glyph { font: 600 42px serif; fill: #d4af5a; }
  .sign-wheel .ruler-glyph { font: 700 40px serif; fill: #120e1f; }
  .sign-wheel .ruler-name { font: 700 17px var(--font-body); fill: #120e1f; letter-spacing: 0.02em; }
  .sign-wheel .elem-name { font: 700 15px var(--font-body); fill: #4a3f5c; letter-spacing: 0.06em; }
  .wheel .season-name { font: 700 28px var(--font-display); fill: #120e1f; letter-spacing: 0.18em; }
  .wheel .elem { cursor: pointer; outline: none; }
  .wheel .elem-outline { fill: none; stroke: transparent; stroke-width: 6; transition: stroke 0.3s; }
  .wheel .season:hover .elem-outline, .wheel .season:focus-visible .elem-outline { stroke: rgba(212, 175, 90, 0.8); }
  .wheel .season.is-on .elem-outline { stroke: #d4af5a; stroke-width: 9; filter: url(#glow); }
  /* curved pills behind labels: a thick round-ended stroke along the ring, over a slightly thicker one for the edge */
  .wheel .pill, .wheel .pill-edge { fill: none; stroke-linecap: round; }
  .wheel .earth-pill .pill { stroke: #D9B66B; stroke-width: 30; }
  .wheel .earth-pill .pill-edge { stroke: #120e1f; stroke-width: 34; transition: stroke 0.3s; }
  .wheel .earth-pill text { font: 700 17px var(--font-body); fill: #120e1f; letter-spacing: 0.06em; }
