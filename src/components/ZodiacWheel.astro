---
// The interactive Chinese zodiac wheel, laid out like the original hand-drawn wheel.
// Rings, from the outside in:
//   1. the outer edge: the four season elements (Water, Wood, Fire, Metal) and the animals' numbers 1 to 12
//   2. the 12 animals, each with its gold medallion and name, coloured by friend group (same colour = friends)
//   3. the inner colour ring: secret friends share a colour
//   4. the years, newest on the outside, every 12 years further in
// Directly opposite animals clash. Selecting an animal or a year turns the wheel so that animal sits at the top,
// under the gold marker, and the three boxes below the wheel explain its friends, secret friend and clash.
import BirthDate from "./BirthDate.astro";
import { ANIMALS, SECRET_FRIENDS, SEASONS, ELEMENTS, EARTH_ANIMALS } from "../data/zodiac.ts";

const R = {
  centre: 54,
  yearsIn: 58, yearsOut: 242,
  secretIn: 246, secretOut: 278,
  animalIn: 282, animalOut: 430,
  numIn: 432, numOut: 458,
  rimIn: 458, rimOut: 492,
};
const YEAR_ROW_GAP = 20;
const YEAR_ROWS = 9; // 9 rows of 12 years reach back to the 1920s
const rad = (deg: number) => (deg * Math.PI) / 180;
const angleOf = (i: number) => -90 + i * 30;
const pt = (i: number, r: number) => [r * Math.cos(rad(angleOf(i))), r * Math.sin(rad(angleOf(i)))].map((v) => +v.toFixed(2));
/** Rotation that lays text along the ring, flipped on the lower half so nothing is upside down. The script redoes this as the wheel turns. */
const along = (i: number) => {
  const a = angleOf(i);
  return Math.sin(rad(a)) > 0.01 ? a - 90 : a + 90;
};
/** Attributes for a piece of text laid along the ring at segment position i. */
const tt = (i: number, r: number) => {
  const [x, y] = pt(i, r);
  return { "data-i": i, "data-x": x, "data-y": y, transform: `translate(${x} ${y}) rotate(${along(i)})` };
};

function wedge(i: number, r0: number, r1: number, span = 1) {
  const a0 = rad(angleOf(i) - 15), a1 = rad(angleOf(i) - 15 + 30 * span);
  const p = (r: number, a: number) => `${(r * Math.cos(a)).toFixed(2)} ${(r * Math.sin(a)).toFixed(2)}`;
  return `M${p(r1, a0)} A${r1} ${r1} 0 0 1 ${p(r1, a1)} L${p(r0, a1)} A${r0} ${r0} 0 0 0 ${p(r0, a0)} Z`;
}

const secretColour = (id: string) => SECRET_FRIENDS.find((s) => s.pair.includes(id))!.colour;

/** The newest year shown for each animal: the window 2019 (Pig) to 2030 (Dog), as on the drawn wheel. */
const topYear = (i: number) => 2019 + ((i - 11 + 12) % 12);
const yearLabel = (y: number, row: number) => (row < 3 ? String(y) : String(y).slice(2));
---

<section class="wheel-wrap" aria-labelledby="wheel-title">
  <div class="wheel-col">
    <svg class="wheel" viewBox="-500 -520 1000 1020" role="group" aria-labelledby="wheel-title" style="--spin: 0deg">
      <defs>
        {ANIMALS.map((a) => (
          <radialGradient id={`g-${a.id}`} gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R.animalOut}>
            <stop offset="0.64" stop-color={a.colour} stop-opacity="0.85" />
            <stop offset="1" stop-color={a.colour} />
          </radialGradient>
        ))}
        <radialGradient id="g-paper" gradientUnits="userSpaceOnUse" cx="0" cy="0" r={R.yearsOut}>
          <stop offset="0" stop-color="#ece5d6" />
          <stop offset="1" stop-color="#faf6ee" />
        </radialGradient>
        <filter id="lift" x="-30%" y="-30%" width="160%" height="160%">
          <feDropShadow dx="0" dy="5" stdDeviation="5" flood-color="#1d1729" flood-opacity="0.45" />
        </filter>
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="7" result="b" />
          <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>

      <g class="rot">
        <!-- outer edge: the four seasons and their elements, plus Earth at the turn of each season. Tap one for its meaning. -->
        <g class="rim">
          {SEASONS.map((s) => {
            const first = ANIMALS.find((a) => a.id === s.animals[0])!.index;
            const mid = ANIMALS.find((a) => a.id === s.animals[1])!;
            return (
              <g class="season elem" data-element={s.element} tabindex="0" role="button" aria-label={`${s.element}: what this element means`}>
                <path class="band" d={wedge(first, R.rimIn, R.rimOut, 3)} fill={s.colour} />
                <text class="season-name tt" {...tt(mid.index, (R.rimIn + R.rimOut) / 2)} y="8" text-anchor="middle">{`${ELEMENTS[s.element].glyph} ${s.element.toUpperCase()}`}</text>
                <path class="elem-outline" d={wedge(first, R.rimIn, R.rimOut, 3)} />
              </g>
            );
          })}
          {EARTH_ANIMALS.map((id) => {
            const a = ANIMALS.find((x) => x.id === id)!;
            return (
              <g class="earth-pill elem tt" data-element="Earth" {...tt(a.index, (R.rimIn + R.rimOut) / 2)} tabindex="0" role="button" aria-label="Earth: what this element means">
                <rect x="-50" y="-13" width="100" height="26" rx="13" />
                <text y="6" text-anchor="middle">土 EARTH</text>
              </g>
            );
          })}
        </g>

        <!-- the 12 animal segments: number band, animal ring and secret-friend ring -->
        {ANIMALS.map((a) => {
          const [ix, iy] = pt(a.index, 368);
          return (
            <g class="seg" data-id={a.id} tabindex="0" role="button" aria-label={`${a.name}: turn the wheel to the ${a.name}`}>
              <path class="num-band" d={wedge(a.index, R.numIn, R.numOut)} />
              <text class="num tt" {...tt(a.index, (R.numIn + R.numOut) / 2)} y="7" text-anchor="middle">{a.index + 1}</text>
              <path class="animal" d={wedge(a.index, R.animalIn, R.animalOut)} fill={`url(#g-${a.id})`} />
              <path class="secret" d={wedge(a.index, R.secretIn, R.secretOut)} fill={secretColour(a.id)} />
              <g transform={`translate(${ix} ${iy})`}><g class="upright">
                <image class="render" href={`/animals/${a.id}.png`} x="-44" y="-44" width="88" height="88" filter="url(#lift)" />
              </g></g>
              <text class="name tt" {...tt(a.index, 304)} y="9" text-anchor="middle">{a.name.toUpperCase()}</text>
              <g class="badge tt" {...tt(a.index, 418)} aria-hidden="true">
                <rect x="-60" y="-12" width="120" height="24" rx="12" />
                <text y="5" text-anchor="middle"></text>
              </g>
              <path class="outline" d={wedge(a.index, R.secretIn, R.numOut)} />
            </g>
          );
        })}

        <!-- the years: newest on the outside, 12 years further back on each row inwards -->
        <g class="years">
          <circle r={R.yearsOut} fill="url(#g-paper)" />
          {ANIMALS.map((a) => (
            <g class="year-col" data-for={a.id}>
              {Array.from({ length: YEAR_ROWS }, (_, row) => {
                const y = topYear(a.index) - 12 * row;
                const r = R.yearsOut - 12 - row * YEAR_ROW_GAP;
                return (
                  <g class="year" data-year={y} data-id={a.id} role="button" aria-label={`${y}, year of the ${a.name}`}>
                    <path class="cell" d={wedge(a.index, r - YEAR_ROW_GAP / 2, r + YEAR_ROW_GAP / 2)} />
                    <text class="tt" {...tt(a.index, r)} y="6" text-anchor="middle">{yearLabel(y, row)}</text>
                  </g>
                );
              })}
            </g>
          ))}
          {ANIMALS.map((a) => {
            const [x1, y1] = pt(a.index - 0.5, R.centre);
            const [x2, y2] = pt(a.index - 0.5, R.yearsOut);
            return <line class="spoke" x1={x1} y1={y1} x2={x2} y2={y2} aria-hidden="true" />;
          })}
        </g>

        <!-- ink lines between rings, like the drawn wheel -->
        <g class="ink" aria-hidden="true" pointer-events="none">
          {[R.yearsOut, R.secretIn, R.secretOut, R.animalIn, R.animalOut, R.numOut, R.rimOut].map((r) => <circle r={r} />)}
          {ANIMALS.map((a) => {
            const [x1, y1] = pt(a.index - 0.5, R.secretIn);
            const [x2, y2] = pt(a.index - 0.5, R.numOut);
            return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
          })}
        </g>
      </g>

      <!-- the selected animal: the gold marker at the top stays still while the wheel turns -->
      <g class="marker" aria-hidden="true" pointer-events="none">
        <path d="M-26 -518 L26 -518 L0 -486 Z" />
      </g>

      <g class="centre" aria-hidden="true" pointer-events="none">
        <circle r={R.centre} />
        <image class="centre-img" href="/animals/rat.png" x="-46" y="-46" width="92" height="92" />
        <text class="centre-glyph" y="20" text-anchor="middle"></text>
      </g>
    </svg>

    <h3 class="select-title">Select an animal, year or element</h3>
    <div class="insights" data-insights>
      <div class="insight" data-kind="friends"><p class="label">Friends</p><div class="body"></div></div>
      <div class="insight" data-kind="secret"><p class="label">Secret friend</p><div class="body"></div></div>
      <div class="insight" data-kind="clash"><p class="label">Clash</p><div class="body"></div></div>
    </div>
  </div>

  <aside class="info panel" aria-live="polite">
    <p class="eyebrow">The Chinese zodiac wheel</p>
    <h2 id="wheel-title">Find your animal</h2>
    <form class="finder" autocomplete="off">
      <div class="row">
        <BirthDate id="wheel-date" name="date" label="Your birth date" required />
        <button class="btn" type="submit">Show me</button>
      </div>
    </form>
    <div class="details" data-details data-glossary></div>
  </aside>
</section>

<style>
  .wheel-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }
  @media (max-width: 900px) { .wheel-wrap { grid-template-columns: 1fr; } }

  .wheel { width: 100%; height: auto; display: block; overflow: visible; filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.55)); }
  .wheel text { pointer-events: none; }
  .wheel .rot { transform: rotate(var(--spin)); transition: transform 1.3s cubic-bezier(0.65, 0, 0.35, 1); }
  .wheel .upright { transform: rotate(calc(-1 * var(--spin))); transition: transform 1.3s cubic-bezier(0.65, 0, 0.35, 1); }
  .wheel.no-anim .rot, .wheel.no-anim .upright { transition: none; }
  @media (prefers-reduced-motion: reduce) { .wheel .rot, .wheel .upright { transition: none; } }

  .wheel .season-name { font: 700 24px var(--font-display); fill: #120e1f; letter-spacing: 0.22em; }
  .wheel .elem { cursor: pointer; outline: none; }
  .wheel .elem-outline { fill: none; stroke: transparent; stroke-width: 6; transition: stroke 0.3s; }
  .wheel .season:hover .elem-outline, .wheel .season:focus-visible .elem-outline { stroke: rgba(212, 175, 90, 0.8); }
  .wheel .season.is-on .elem-outline { stroke: #d4af5a; stroke-width: 9; filter: url(#glow); }
  .wheel .earth-pill rect { fill: #D9B66B; stroke: #120e1f; stroke-width: 2; transition: stroke 0.3s; }
  .wheel .earth-pill text { font: 700 14px var(--font-body); fill: #120e1f; letter-spacing: 0.1em; }
  .wheel .earth-pill:hover rect, .wheel .earth-pill:focus-visible rect { stroke: #d4af5a; stroke-width: 3; }
  .wheel .earth-pill.is-on rect { stroke: #d4af5a; stroke-width: 4; filter: url(#glow); }
  .wheel .num-band { fill: #faf6ee; }
  .wheel .num { font: 700 19px var(--font-display); fill: #2a2135; }
  .wheel .name { font: 700 26px var(--font-display); fill: #120e1f; letter-spacing: 0.05em; paint-order: stroke; stroke: rgba(255, 255, 255, 0.35); stroke-width: 3px; }
  .wheel .ink circle, .wheel .ink line { fill: none; stroke: #1d1729; stroke-width: 2.4; }
  .wheel .spoke { stroke: #1d1729; stroke-width: 1.6; }
  .wheel .centre circle { fill: #120e1f; stroke: #d4af5a; stroke-width: 3; }
  .wheel .centre-glyph { font: 600 56px serif; fill: #d4af5a; }
  .wheel .marker path { fill: #d4af5a; stroke: #120e1f; stroke-width: 3; filter: url(#glow); }

  .wheel .seg { cursor: pointer; outline: none; }
  .wheel .seg .outline { fill: none; stroke: transparent; stroke-width: 6; transition: stroke 0.3s; }
  .wheel .seg:hover .outline, .wheel .seg:focus-visible .outline { stroke: rgba(212, 175, 90, 0.75); }
  .wheel .seg.is-friend .outline { stroke: #ffffff; stroke-width: 6; }
  .wheel .seg.is-secret .outline { stroke: #d4af5a; stroke-width: 6; stroke-dasharray: 4 9; stroke-linecap: round; }
  .wheel .seg.is-clash .outline { stroke: #d8343c; stroke-width: 7; }
  .wheel .seg.is-self .outline { stroke: #d4af5a; stroke-width: 10; filter: url(#glow); }
  .wheel .seg.is-self .secret, .wheel .seg.is-secret .secret { animation: pulse 2.2s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.5; } }

  .wheel .badge { display: none; }
  .wheel .badge.is-on { display: inline; }
  .wheel .badge rect { fill: #120e1f; stroke: #d4af5a; stroke-width: 1.5; }
  .wheel .badge.k-clash rect { stroke: #ff6b70; }
  .wheel .badge text { font: 700 14px var(--font-body); fill: #faf6ee; letter-spacing: 0.12em; }

  .wheel .year { cursor: pointer; outline: none; }
  .wheel .year .cell { fill: transparent; transition: fill 0.3s; }
  .wheel .year:hover .cell { fill: rgba(212, 175, 90, 0.3); }
  .wheel .year text { font: 700 17px var(--font-body); fill: #120e1f; font-variant-numeric: tabular-nums; }
  .wheel .year-col.is-self .cell { fill: rgba(212, 175, 90, 0.16); }
  .wheel .year.is-picked .cell { fill: #d4af5a; }

  .select-title { margin: 18px 0 10px; font-size: 1.15rem; text-align: center; color: var(--gold); }
  .insights { display: grid; gap: 10px; }
  .insight {
    display: grid; grid-template-columns: 132px minmax(0, 1fr); align-items: stretch;
    border-radius: 14px; overflow: hidden; border: 1px solid rgba(156, 122, 60, 0.4); background: rgba(18, 14, 31, 0.82);
  }
  .insight .label {
    margin: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 12px;
    font: 700 1rem var(--font-display); letter-spacing: 0.06em; color: #120e1f; background: var(--c, var(--gold));
  }
  .insight[data-kind="clash"] .label { color: #fff; }
  .insight .body { padding: 12px 16px; font-size: 0.95rem; }
  .insight :global(.who) { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .insight :global(.who img) { width: 40px; height: 40px; }
  .insight :global(.who strong) { color: var(--gold); font-size: 1.05rem; }
  .insight :global(p) { margin: 4px 0; }
  .insight :global(.elem-link) { background: none; border: 0; padding: 0; font: inherit; font-weight: 700; color: var(--gold); text-decoration: underline dotted; text-underline-offset: 3px; cursor: pointer; }
  .insight :global(.next) { color: var(--mist); font-size: 0.85rem; }
  @media (max-width: 520px) { .insight { grid-template-columns: 1fr; } .insight .label { padding: 8px; } }

  .finder .row { display: flex; flex-wrap: wrap; align-items: end; gap: 10px; }
  .finder .row :global(.birthdate) { flex: 1 1 260px; }
  .details { margin-top: 22px; }
  .details :global(.head) { display: grid; grid-template-columns: 84px 1fr; gap: 14px; align-items: center; }
  .details :global(.head img) { width: 84px; height: 84px; }
  .details :global(h3) { font-size: 1.7rem; margin: 0; }
  .details :global(.elem-link) { background: none; border: 0; padding: 0; font: inherit; color: var(--gold); text-decoration: underline dotted; text-underline-offset: 3px; cursor: pointer; }
  .details :global(.elem-chips) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .details :global(.elem-chips button) { border-radius: 999px; padding: 5px 12px; font: inherit; font-size: 0.85rem; cursor: pointer; border: 1px solid #120e1f; color: #120e1f; font-weight: 600; }
  .details :global(.elem-chips button[aria-pressed="true"]) { outline: 2px solid var(--gold); outline-offset: 2px; }
  .details :global(.glyph) { width: 84px; height: 84px; border-radius: 50%; display: grid; place-items: center; font-size: 2.6rem; color: #120e1f; border: 3px solid var(--gold); font-family: serif; }
  .details :global(.aka) { margin: 4px 0 0; font-size: 0.85rem; font-style: italic; color: #e9d9b0; }
  .details :global(.sub) { margin: 2px 0 0; color: var(--mist); font-size: 0.9rem; }
  .details :global(.year-box) { border: 1px solid var(--gold); border-radius: 12px; padding: 10px 14px; margin: 0 0 16px; background: rgba(212, 175, 90, 0.08); }
  .details :global(.year-box p) { margin: 4px 0; font-size: 0.95rem; }
  .details :global(.tags) { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; padding: 0; list-style: none; }
  .details :global(.tags li) { font-size: 0.8rem; padding: 3px 10px; border-radius: 999px; border: 1px solid rgba(212, 175, 90, 0.45); color: #e9d9b0; }
  .details :global(dl) { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 8px 14px; margin: 14px 0; font-size: 0.95rem; }
  .details :global(dt) { color: var(--gold); font-family: var(--font-display); font-size: 0.85rem; letter-spacing: 0.05em; padding-top: 2px; }
  .details :global(dd) { margin: 0; }
  .details :global(.lucky) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 14px 0; }
  .details :global(.lucky div) { border: 1px solid rgba(156, 122, 60, 0.35); border-radius: 12px; padding: 8px 10px; background: rgba(18, 14, 31, 0.6); }
  .details :global(.lucky span) { display: block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mist); }
  .details :global(.lucky b) { font-weight: 600; font-size: 0.92rem; }
  .details :global(.compare) { margin-top: 18px; border-top: 1px solid rgba(156, 122, 60, 0.3); padding-top: 14px; }
  .details :global(.compare h4), .details :global(.years-note h4) { margin: 0 0 8px; font-size: 1rem; }
  .details :global(.chips) { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; }
  .details :global(.chips button) { background: rgba(18, 14, 31, 0.75); border: 1px solid rgba(156, 122, 60, 0.35); border-radius: 10px; padding: 4px 2px; cursor: pointer; color: var(--mist); font: inherit; font-size: 0.72rem; display: grid; justify-items: center; gap: 2px; }
  .details :global(.chips button[aria-pressed="true"]) { border-color: #8e6bd9; background: rgba(59, 31, 107, 0.7); color: var(--moonlight); }
  .details :global(.chips img) { width: 30px; height: 30px; }
  .details :global(.verdict) { margin: 12px 0 0; padding: 10px 12px; border-radius: 12px; background: rgba(59, 31, 107, 0.45); font-size: 0.95rem; }
  .details :global(.years-note) { font-size: 0.92rem; border-top: 1px solid rgba(156, 122, 60, 0.3); padding-top: 14px; margin-top: 18px; }
  .details :global(.years-note p) { margin: 6px 0; }
  .details :global(.good) { color: #8fd3a5; }
  .details :global(.hard) { color: #ff8a8f; }
</style>

<script>
  import { initWheel } from "../scripts/wheel.ts";
  initWheel(document.querySelector(".wheel-wrap")!);
</script>
