---
// The astrology part of a reading: the birth chart, built in the visitor's browser
// from the details in the link (d = date, t = time, p = place, tier).
import { getCollection } from "astro:content";

// Library article ids, so the chart links to an article only when it exists.
const articles = (await getCollection("library")).map((a) => a.id);
---

<section class="container chart" data-chart data-articles={JSON.stringify(articles)}></section>

<style>
  .chart { max-width: 900px; margin-top: 48px; }
  .chart :global(.big3) { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 20px 0; }
  .chart :global(.big3 .panel) { text-align: center; padding: 20px 14px; }
  .chart :global(.big3 .g) { display: block; font-size: 2.4rem; color: var(--gold); line-height: 1.1; text-shadow: 0 0 24px rgba(212, 175, 90, 0.35); }
  .chart :global(.big3 .s) { display: block; font: 600 1.3rem var(--font-display); margin-top: 4px; }
  .chart :global(.big3 .w), .chart :global(.card .w) { font-size: 0.8rem; color: var(--mist); text-transform: uppercase; letter-spacing: 0.12em; }
  .chart :global(.big3 p) { font-size: 0.92rem; margin: 8px 0 0; }
  .chart :global(.notice) { border-left: 2px solid var(--orchid); padding-left: 14px; }
  .chart :global(.rows) { list-style: none; padding: 0; margin: 16px 0; display: grid; gap: 8px; }
  .chart :global(.rows li) { display: grid; grid-template-columns: 2rem 1fr; gap: 10px; align-items: baseline; }
  .chart :global(.rows .gl) { color: var(--gold); font-size: 1.3rem; text-align: center; }
  .chart :global(.cards) { display: grid; gap: 14px; margin: 18px 0; }
  .chart :global(.card h3) { margin: 2px 0 6px; }
  .chart :global(.card h3 .gl) { color: var(--gold); margin-right: 6px; }
  .chart :global(.card .gov) { color: var(--gold); font-family: var(--font-display); margin: 6px 0; }
  .chart :global(.card p) { margin: 8px 0; }
  .chart :global(.card .facts) { font-size: 0.85rem; color: var(--mist); }
  .chart :global(.card .more), .chart :global(.how-card .more) { font-size: 0.9rem; margin: 10px 0 0; }
  .chart :global(.wheel) { display: block; width: min(100%, 440px); margin: 20px auto; }
  .chart :global(.wheel text) { font-family: var(--font-body); }
  .chart :global(.legend) { text-align: center; font-size: 0.85rem; }
  .chart :global(.legend span) { margin: 0 8px; white-space: nowrap; }
  .chart :global(table) { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .chart :global(th), .chart :global(td) { text-align: left; padding: 6px 8px; border-bottom: 1px solid rgba(142, 107, 217, 0.25); vertical-align: top; }
  .chart :global(th) { color: var(--gold); font-weight: 500; }
  .chart :global(.balance) { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .chart :global(section.part) { margin-top: 28px; }
  .chart :global(.how) { margin-top: 14px; }
  .chart :global(.how > summary) { cursor: pointer; font-family: var(--font-display); color: var(--gold); font-size: 1.05rem; }
  .chart :global(.how-card) { margin-top: 14px; }
  .chart :global(.how-card h3) { margin: 0 0 4px; }
  .chart :global(.how-card ol) { margin: 10px 0; padding-left: 22px; }
  .chart :global(.how-card li) { margin: 4px 0; }
  .chart :global(.how-card .result) { color: var(--gold); font-family: var(--font-display); margin: 8px 0 0; }
  .chart :global(.how-card .note) { font-size: 0.9rem; border-left: 2px solid var(--orchid); padding-left: 12px; margin-top: 12px; }
  @media (max-width: 640px) { .chart :global(.big3), .chart :global(.balance) { grid-template-columns: 1fr; } }
</style>

<script>
  import { birthChart, localToUtc, signChangesDuring, balance, formatDegree, type Chart, type PointPosition } from "../lib/astrology.ts";
  import { findPlace, type Place } from "../lib/place.ts";
  import { SIGNS, PLANET_BY_ID, HOUSES, ASPECTS, ELEMENT_MEANING, MODALITY_MEANING, type PointId, type Element, type Modality } from "../data/astrology.ts";
  import { PLACEMENTS } from "../data/placements.ts";
  import { momentBreakdown, planetsBreakdown, risingBreakdown, housesBreakdown, aspectsBreakdown, lilithBreakdown, ordinal, type BirthMoment, type ChartBreakdown } from "../lib/astro-explain.ts";

  const q = new URLSearchParams(location.search);
  const tier = (q.get("tier") ?? "first") as "glance" | "first" | "deep";
  const date = q.get("d") ?? "";
  const timeIn = q.get("t") ?? "";
  const time = /^\d{2}:\d{2}$/.test(timeIn) ? timeIn : "";
  const placeText = (q.get("p") ?? "").trim();
  const root = document.querySelector<HTMLElement>("[data-chart]")!;
  const articles = new Set<string>(JSON.parse(root.dataset.articles ?? "[]"));
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const link = (id: string, label: string) => (articles.has(id) ? `<a href="/library/${id}">${esc(label)}</a>` : "");

  if (/^\d{4}-\d{2}-\d{2}$/.test(date)) start();

  async function start() {
    let place: Place | null = null;
    let placeProblem = "";
    if (placeText) {
      root.innerHTML = `<p class="muted">Finding ${esc(placeText)} on the map for your birth chart…</p>`;
      try {
        place = await findPlace(placeText);
        if (!place) placeProblem = `We could not find "${esc(placeText)}" on the map. Try the nearest large town, or add the country, like "Paris, France".`;
      } catch {
        placeProblem = `We could not reach the place finder just now, so your birthplace is left out. Reloading the page usually fixes this.`;
      }
    }
    try {
      root.innerHTML = render(place, placeProblem);
    } catch (e) {
      console.error(e);
      root.innerHTML = `<p class="muted">Sorry, your birth chart could not be drawn. Please check your birth date and try again.</p>`;
      return;
    }
    root.setAttribute("data-glossary", "");
    document.dispatchEvent(new Event("glossary:scan"));
  }

  function moment(place: Place | null): { m: BirthMoment; utc: Date } {
    const deviceZone = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
    // without a birthplace, the best guess for the time zone is this device's own
    const timeZone = place?.timeZone ?? deviceZone;
    const { utc, offsetMinutes } = localToUtc(date, time || "12:00", timeZone);
    return { utc, m: { date, time, place, timeZone, offsetMinutes, zoneFromDevice: !place } };
  }

  function render(place: Place | null, placeProblem: string) {
    const { m, utc } = moment(place);
    // the Rising sign and houses need both the time and the place
    const chart = birthChart(utc, time && place ? place : undefined);
    const byId = Object.fromEntries(chart.points.map((p) => [p.id, p])) as Record<PointId, PointPosition>;

    // without a time, a fast planet can change sign during the birth day
    let unsure: ReturnType<typeof signChangesDuring> = [];
    if (!time) unsure = signChangesDuring(localToUtc(date, "00:00", m.timeZone).utc, localToUtc(date, "23:59", m.timeZone).utc);
    const clock = (d: Date) => new Intl.DateTimeFormat("en-GB", { timeZone: m.timeZone, hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(d);
    const unsureOf = (id: PointId) => unsure.find((u) => u.id === id);

    const notices: string[] = [];
    if (placeProblem) notices.push(placeProblem);
    if (!time && !place) notices.push(`You did not give a birth time or town, so your Rising sign and houses are left out, and the planets are placed at midday. <a href="/">Add them</a> for the full chart.`);
    else if (!time) notices.push(`You did not give a birth time, so your Rising sign and houses are left out, and the planets are placed at midday. <a href="/">Add your birth time</a> for the full chart.`);
    else if (!place) notices.push(`You did not give a birth town, so your Rising sign and houses are left out. <a href="/">Add your town</a> for the full chart.`);
    for (const u of unsure) notices.push(`Your ${PLANET_BY_ID[u.id].name} moved from ${u.from.name} into ${u.to.name} at about ${clock(u.at)} on your birth day${place ? "" : " (in this device's time zone)"}. If you were born before then, your ${PLANET_BY_ID[u.id].name} is in ${u.from.name}; after, it is in ${u.to.name}.${tier === "glance" ? "" : ` We show ${byId[u.id].sign.name}, its sign at midday, and both meanings below.`}`);

    let html = `
      <p class="eyebrow">Astrology</p>
      <h2>Your birth chart</h2>
      ${tier === "first" ? `<p class="muted">Your birth chart is a snapshot of the sky at the moment you were born. Each planet stands for a part of you, like your feelings or your drive, and its sign shows how that part of you behaves.</p>` : ""}
      ${place ? `<p class="muted">Drawn for ${esc(place.label)}${time ? ` at ${time}` : ""}.</p>` : ""}
      ${notices.map((n) => `<p class="notice muted">${n}</p>`).join("")}
      ${bigThree(chart, byId)}`;

    if (tier === "glance") {
      html += `<section class="part"><h3>Your planets at a glance</h3><ul class="rows">${chart.points
        .filter((p) => p.id !== "sun" && p.id !== "moon")
        .map((p) => `<li><span class="gl">${PLANET_BY_ID[p.id].glyph}</span><span><strong>${PLANET_BY_ID[p.id].name} in ${p.sign.name}</strong> <span class="muted">(${PLANET_BY_ID[p.id].governs})</span>: ${PLACEMENTS[p.id][p.sign.id].glance}.</span></li>`)
        .join("")}</ul></section>`;
    } else {
      html += `<section class="part">${wheel(chart)}</section>`;
      html += `<section class="part"><h3>Your planets, one by one</h3>
        ${tier === "first" ? `<p class="muted">For each planet you will see what it governs, then what its sign says about you.</p>` : ""}
        <div class="cards">${chart.points.map((p) => planetCard(p, unsureOf(p.id))).join("")}${chart.angles ? risingCard(chart) : ""}</div></section>`;
      html += balanceSection(chart);
      html += aspectsSection(chart);
      if (tier === "deep" && chart.houses) html += housesSection(chart);
    }

    const how: ChartBreakdown[] = [momentBreakdown(m, chart), planetsBreakdown(chart)];
    if (chart.angles && place) how.push(risingBreakdown(chart, place)!, housesBreakdown(chart)!);
    how.push(aspectsBreakdown(chart), lilithBreakdown(chart));
    html += `
      <section class="part">
        <details class="how" id="how-chart"${tier === "glance" ? "" : " open"}>
          <summary>How your birth chart was calculated</summary>
          <p class="muted">Every placement above comes from your birth date${time ? ", time" : ""}${place ? " and place" : ""}. Here are the steps with your own details, so you can see exactly where each one comes from.</p>
          ${how.map(howCard).join("")}
        </details>
      </section>`;
    return html;
  }

  function bigThree(chart: Chart, byId: Record<PointId, PointPosition>) {
    const card = (what: string, glyph: string, sign: string, body: string) =>
      `<div class="panel"><span class="w">${what}</span><span class="g">${glyph}</span><span class="s">${sign}</span>${body}</div>`;
    const one = (id: "sun" | "moon") => {
      const p = byId[id];
      const deg = tier === "deep" ? ` ${formatDegree(p.degree)}` : "";
      return card(`${PLANET_BY_ID[id].name} sign`, p.sign.glyph, `${p.sign.name}${deg}`, `<p class="muted">${PLACEMENTS[id][p.sign.id].glance}.</p>`);
    };
    const asc = chart.angles?.asc;
    const rising = asc
      ? card("Rising sign", asc.sign.glyph, `${asc.sign.name}${tier === "deep" ? ` ${formatDegree(asc.degree)}` : ""}`, `<p class="muted">${PLACEMENTS.rising[asc.sign.id].glance}.</p>`)
      : card("Rising sign", "?", "Not yet known", `<p class="muted">Needs your birth time and town. <a href="/">Add them</a></p>`);
    return `<section class="part"><h3>Your Big Three</h3>${tier === "glance" ? "" : `<p class="muted">Your Sun is your core self, your Moon is your emotional side, and your Rising sign is the first impression you give.</p>`}<div class="big3">${one("sun")}${one("moon")}${rising}</div></section>`;
  }

  function planetCard(p: PointPosition, unsure?: { from: (typeof SIGNS)[number]; to: (typeof SIGNS)[number] }) {
    const planet = PLANET_BY_ID[p.id];
    const place = PLACEMENTS[p.id][p.sign.id];
    const facts: string[] = [];
    if (tier === "deep") facts.push(`${formatDegree(p.degree)} ${p.sign.name}`, `${p.sign.element} sign`, `${p.sign.modality} sign`);
    if (p.retrograde) facts.push("retrograde");
    const house = p.house
      ? `<p>In your <strong>${ordinal(p.house)} house</strong>, the area of ${HOUSES[p.house - 1].area}, so this is where in life you will notice it most.</p>`
      : "";
    const other = unsure ? (unsure.from.id === p.sign.id ? unsure.to : unsure.from) : null;
    const otherText = other
      ? `<p class="facts">If you were born ${other.id === unsure!.to.id ? "later" : "earlier"} in the day, your ${planet.name} was in ${other.name}: ${PLACEMENTS[p.id][other.id].text}</p>`
      : "";
    const retro = p.retrograde && tier === "deep" ? `<p class="facts">Retrograde at your birth: its themes tend to turn inward, so you may process them privately or revisit them over time.</p>` : "";
    const links = [planet.article ? link(planet.article, `More about ${planet.name}`) : "", link(`sun-moon-rising/${p.sign.id}`, `More about ${p.sign.name}`)].filter(Boolean);
    return `
      <div class="panel card" id="chart-${p.id}">
        <span class="w">${planet.name} governs ${planet.governs}</span>
        <h3><span class="gl">${planet.glyph}</span>${planet.name} in ${p.sign.glyph} ${p.sign.name}</h3>
        ${facts.length ? `<p class="facts">${facts.join(" · ")}</p>` : ""}
        ${tier === "first" || tier === "deep" ? `<p class="muted">${planet.about} It spends ${planet.pace}.</p>` : ""}
        <p class="gov">${place.glance}</p>
        <p>${place.text}</p>
        ${house}${retro}${otherText}
        ${links.length ? `<p class="more">${links.join(" · ")}</p>` : ""}
      </div>`;
  }

  function risingCard(chart: Chart) {
    const asc = chart.angles!.asc;
    const p = PLACEMENTS.rising[asc.sign.id];
    const links = [link("sun-moon-rising/rising-sign", "More about your Rising sign"), link(`sun-moon-rising/${asc.sign.id}`, `More about ${asc.sign.name}`)].filter(Boolean);
    return `
      <div class="panel card" id="chart-rising">
        <span class="w">Your Rising sign governs first impressions</span>
        <h3><span class="gl">AC</span>Rising in ${asc.sign.glyph} ${asc.sign.name}</h3>
        ${tier === "deep" ? `<p class="facts">${formatDegree(asc.degree)} ${asc.sign.name} · Midheaven ${formatDegree(chart.angles!.mc.degree)} ${chart.angles!.mc.sign.name}</p>` : ""}
        <p class="muted">Your Rising sign, or Ascendant, is the sign that was coming up over the eastern horizon when you were born. It is how you meet the world and the first impression you give, and it changes about every two hours.</p>
        <p class="gov">${p.glance}</p>
        <p>${p.text}</p>
        ${links.length ? `<p class="more">${links.join(" · ")}</p>` : ""}
      </div>`;
  }

  function balanceSection(chart: Chart) {
    const { elements, modalities } = balance(chart.points);
    const top = <T extends string>(r: Record<T, PointId[]>) => (Object.entries(r) as [T, PointId[]][]).sort((a, b) => b[1].length - a[1].length)[0];
    const [el, elList] = top(elements as Record<Element, PointId[]>);
    const [mo, moList] = top(modalities as Record<Modality, PointId[]>);
    const names = (ids: PointId[]) => ids.map((id) => PLANET_BY_ID[id].name).join(", ") || "none";
    if (tier === "first") {
      return `<section class="part panel"><h3>Your strongest element</h3><p>${elList.length} of your ten planets are in ${el} signs. ${ELEMENT_MEANING[el]}</p><p class="muted">${MODALITY_MEANING[mo]} You have ${moList.length} planets in ${mo} signs.</p>${link("elements/fire-earth-air-and-water", "More about the four elements")}</section>`;
    }
    const rows = <T extends string>(r: Record<T, PointId[]>, meaning: Record<T, string>) =>
      (Object.entries(r) as [T, PointId[]][]).map(([k, ids]) => `<tr><th>${k}</th><td>${ids.length}</td><td>${names(ids)}<br><span class="muted">${meaning[k]}</span></td></tr>`).join("");
    return `<section class="part"><h3>Elements and modes</h3>
      <p class="muted">Counting your ten planets by element and by mode shows where your chart's energy gathers. You lean most towards ${el} and ${mo}.</p>
      <div class="balance">
        <div class="panel"><table><tr><th>Element</th><th>#</th><th>Planets</th></tr>${rows(elements as Record<Element, PointId[]>, ELEMENT_MEANING)}</table></div>
        <div class="panel"><table><tr><th>Mode</th><th>#</th><th>Planets</th></tr>${rows(modalities as Record<Modality, PointId[]>, MODALITY_MEANING)}</table></div>
      </div>
      <p class="more">${[link("elements/fire-earth-air-and-water", "The four elements"), link("elements/cardinal-fixed-and-mutable", "Cardinal, fixed and mutable")].filter(Boolean).join(" · ")}</p></section>`;
  }

  function aspectsSection(chart: Chart) {
    const list = tier === "first" ? chart.aspects.slice(0, 3) : chart.aspects;
    if (!list.length) return "";
    const items = list.map((h) => {
      const asp = ASPECTS.find((a) => a.id === h.aspect)!;
      const a = PLANET_BY_ID[h.a], b = PLANET_BY_ID[h.b];
      return `<div class="panel card"><span class="w">${asp.feel === "easy" ? "Easy link" : asp.feel === "tense" ? "Tense link" : "Blended"}${tier === "deep" ? ` · ${h.orb.toFixed(1)}° from exact` : ""}</span>
        <h3>${a.glyph} ${a.name} ${asp.glyph} ${asp.name.toLowerCase()} ${b.glyph} ${b.name}</h3>
        <p>${asp.about} Here it links ${a.governs} (${a.name}) with ${b.governs} (${b.name}).</p></div>`;
    });
    return `<section class="part"><h3>${tier === "first" ? "Your three strongest connections" : "Your aspects"}</h3>
      <p class="muted">Aspects are angles between planets. They show which parts of you work together easily and which push against each other.${tier === "first" && chart.aspects.length > 3 ? ` You have ${chart.aspects.length} in total; the Full Deep Dive shows them all.` : ""}</p>
      <div class="cards">${items.join("")}</div>${link("houses-aspects/the-major-aspects", "More about aspects")}</section>`;
  }

  function housesSection(chart: Chart) {
    const h = chart.houses!;
    const rows = HOUSES.map((house, i) => {
      const inside = chart.points.filter((p) => p.house === house.n).map((p) => PLANET_BY_ID[p.id].name);
      const c = h.cusps[i];
      const s = SIGNS[Math.floor(c / 30)];
      return `<tr><th>${ordinal(house.n)}</th><td>${formatDegree(c % 30)} ${s.name}</td><td><strong>${house.area[0].toUpperCase() + house.area.slice(1)}</strong><br><span class="muted">${house.about}</span></td><td>${inside.join(", ") || "<span class=\"muted\">empty</span>"}</td></tr>`;
    }).join("");
    return `<section class="part"><h3>Your twelve houses</h3>
      <p class="muted">The sign at the start of each house colours that area of life, and any planets inside it bring their energy there. An empty house is normal: it just means that area runs more quietly.</p>
      <div class="panel" style="overflow-x:auto"><table><tr><th>House</th><th>Starts at</th><th>Area of life</th><th>Planets</th></tr>${rows}</table></div>
      ${link("houses-aspects/the-twelve-houses", "More about the houses")}</section>`;
  }

  /** A simple chart wheel: signs round the outside, houses inside, planets and aspect lines. */
  function wheel(chart: Chart) {
    const C = 220, R1 = 210, R2 = 178, R3 = 92;
    const ref = chart.angles?.asc.lon ?? 0; // the Rising sign sits on the left, as in most charts
    const pt = (lon: number, r: number) => {
      const a = ((180 + lon - ref) * Math.PI) / 180;
      return [C + r * Math.cos(a), C - r * Math.sin(a)].map((v) => v.toFixed(1));
    };
    const line = (lon: number, r1: number, r2: number, cls: string) => {
      const [x1, y1] = pt(lon, r1), [x2, y2] = pt(lon, r2);
      return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" class="${cls}"/>`;
    };
    let svg = `<circle cx="${C}" cy="${C}" r="${R1}" class="ring"/><circle cx="${C}" cy="${C}" r="${R2}" class="ring"/><circle cx="${C}" cy="${C}" r="${R3}" class="ring faint"/>`;
    SIGNS.forEach((s, i) => {
      svg += line(i * 30, R2, R1, "ring");
      const [x, y] = pt(i * 30 + 15, (R1 + R2) / 2);
      svg += `<text x="${x}" y="${y}" class="sg el-${s.element.toLowerCase()}">${s.glyph}<title>${s.name}</title></text>`;
    });
    if (chart.houses) {
      chart.houses.cusps.forEach((c, i) => {
        const angle = i === 0 || i === 3 || i === 6 || i === 9;
        svg += line(c, R3, R2, angle ? "axis" : "ring faint");
        const next = chart.houses!.cusps[(i + 1) % 12];
        const mid = c + (((next - c + 360) % 360) / 2);
        const [x, y] = pt(mid, R3 + 12);
        svg += `<text x="${x}" y="${y}" class="hn">${i + 1}</text>`;
      });
      const [ax, ay] = pt(chart.houses.cusps[0], R2 + 2);
      svg += `<text x="${(Number(ax) - 4).toFixed(1)}" y="${ay}" class="lbl" text-anchor="end">AC</text>`;
    }
    // aspect lines between planets
    const lonOf = (id: PointId) => chart.points.find((p) => p.id === id)!.lon;
    for (const h of chart.aspects) {
      const feel = ASPECTS.find((a) => a.id === h.aspect)!.feel;
      if (feel === "blend") continue;
      const [x1, y1] = pt(lonOf(h.a), R3 - 4), [x2, y2] = pt(lonOf(h.b), R3 - 4);
      svg += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" class="asp ${feel}"/>`;
    }
    // planets, nudged apart when they sit close together
    const sorted = [...chart.points].sort((a, b) => a.lon - b.lon);
    const shown: number[] = [];
    for (const p of sorted) {
      let l = p.lon;
      while (shown.some((s) => Math.abs(((l - s + 540) % 360) - 180) < 8)) l += 2;
      shown.push(l);
      svg += line(p.lon, R2, R2 - 6, "tick");
      const [x, y] = pt(l, R2 - 24);
      svg += `<text x="${x}" y="${y}" class="pl">${PLANET_BY_ID[p.id].glyph}<title>${PLANET_BY_ID[p.id].name} in ${p.sign.name}</title></text>`;
    }
    return `
      <svg class="wheel" viewBox="0 0 440 440" role="img" aria-label="Your birth chart wheel">
        <style>
          .ring { fill: none; stroke: rgba(212,175,90,0.55); stroke-width: 1; }
          .faint { stroke: rgba(142,107,217,0.35); }
          .axis { stroke: var(--gold); stroke-width: 1.6; }
          .tick { stroke: var(--gold); stroke-width: 1.2; }
          .sg { font-size: 18px; text-anchor: middle; dominant-baseline: central; }
          .el-fire { fill: #ff8a5c; } .el-earth { fill: #b9c46a; } .el-air { fill: #8fd3e8; } .el-water { fill: #8e9bff; }
          .pl { fill: var(--moonlight); font-size: 19px; text-anchor: middle; dominant-baseline: central; }
          .hn { fill: var(--mist); font-size: 10px; text-anchor: middle; dominant-baseline: central; }
          .lbl { fill: var(--gold); font-size: 11px; dominant-baseline: central; }
          .asp { stroke-width: 1; opacity: 0.75; }
          .asp.easy { stroke: var(--orchid); } .asp.tense { stroke: var(--clash); }
        </style>
        ${svg}
      </svg>
      <p class="legend muted"><span style="color:var(--orchid)">━ easy aspects</span><span style="color:var(--clash)">━ tense aspects</span>${chart.angles ? "<span>AC = Rising sign</span>" : ""}</p>
      ${tier === "first" ? `<p class="muted">The outer ring shows the twelve signs. Each symbol inside is a planet, sitting where it was when you were born.${chart.houses ? " The numbers are your twelve houses, and your Rising sign sits on the left, where the Sun rises." : ""} Hover over or tap a symbol to see its name.</p>` : ""}`;
  }

  function howCard(b: ChartBreakdown) {
    const links = b.articles.filter((a) => articles.has(a.id));
    return `
      <div class="panel how-card" id="${b.id}">
        <h3>${esc(b.title)}</h3>
        <p class="muted">${esc(b.intro)}</p>
        <ol>${b.steps.map((s) => `<li>${esc(s)}</li>`).join("")}</ol>
        <p class="result">${esc(b.result)}</p>
        ${b.note ? `<p class="note muted">${esc(b.note)}</p>` : ""}
        ${links.length ? `<p class="more">Learn more in the Library: ${links.map((a) => `<a href="/library/${a.id}">${esc(a.label)}</a>`).join(" · ")}</p>` : ""}
      </div>`;
  }

</script>
