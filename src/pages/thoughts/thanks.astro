---
// Shown after sending a message when JavaScript is switched off.
import Base from "../../layouts/Base.astro";
---

<Base title="Thank you">
  <section class="container" style="padding-top:64px;max-width:760px">
    <h1>Thank you</h1>
    <p>Your message has been sent. If you shared some kind words, they'll appear on the wall once they've been approved.</p>
    <p><a href="/thoughts">Back to Share your thoughts</a></p>
  </section>
</Base>
