---
// Shown when a message couldn't be sent and JavaScript is switched off.
import Base from "../../layouts/Base.astro";
---

<Base title="Message not sent">
  <section class="container" style="padding-top:64px;max-width:760px">
    <h1>Your message wasn't sent</h1>
    <p>Please go back and check that you chose a message type, entered a valid email address and wrote a message of under 2,000 characters with no more than 3 links.</p>
    <p>If you've sent several messages already, please wait an hour and try again.</p>
    <p><a href="/thoughts">Back to Share your thoughts</a></p>
  </section>
</Base>
