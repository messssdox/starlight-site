---
// The standalone numerology area: a calculator that shows every step of the maths.
import Base from "../layouts/Base.astro";
import BirthDate from "../components/BirthDate.astro";
import { getCollection } from "astro:content";
import "../styles/reading.css";

const articles = (await getCollection("library")).map((a) => a.id);
---

<Base title="Numerology" description="Calculate your numerology numbers and see exactly how each one is worked out.">
  <section class="container num">
    <p class="eyebrow">Numerology</p>
    <h1>Your numbers, with the maths shown</h1>
    <p class="lede" data-glossary>
      Numerology turns your birth date and name into a handful of meaningful numbers. Starlight uses the Pythagorean system, the most widely used
      in the West. Every letter has a value from 1 to 9, and numbers are added together until one digit is left, except the master numbers 11, 22
      and 33, which are kept as they are.
    </p>

    <form class="num-form panel" autocomplete="off">
      <div>
        <label for="nm">Full birth name</label>
        <input id="nm" name="n" placeholder="e.g. Ada Lovelace" />
      </div>
      <BirthDate id="dt" name="d" required />
      <button class="btn" type="submit">Calculate</button>
    </form>

    <div class="results reading" data-results data-articles={JSON.stringify(articles)}></div>

    <section class="panel table-wrap" id="letters">
      <h2>The letter values</h2>
      <table>
        <thead><tr>{[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n) => <th>{n}</th>)}</tr></thead>
        <tbody>
          {["ABCDEFGHI", "JKLMNOPQR", "STUVWXYZ"].map((row) => (
            <tr>{row.split("").map((c) => <td>{c}</td>)}</tr>
          ))}
        </tbody>
      </table>
      <p class="muted">Vowels (A, E, I, O, U) give the Soul Urge number; consonants give the Personality number; all letters together give the Expression number.</p>
    </section>
  </section>
</Base>

<style>
  .num { padding-top: 48px; max-width: 900px; }
  .lede { font-family: var(--font-reading); font-size: 1.2rem; color: var(--mist); }
  .num-form { display: grid; grid-template-columns: 2fr 1fr auto; gap: 14px; align-items: end; margin: 28px 0; }
  .results.reading { padding-top: 0; }
  .table-wrap { margin-top: 32px; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; text-align: center; font-family: var(--font-display); }
  th { color: var(--gold); padding: 8px; border-bottom: 1px solid rgba(212, 175, 90, 0.4); }
  td { padding: 8px; color: var(--moonlight); }
  @media (max-width: 720px) { .num-form { grid-template-columns: 1fr; } }
</style>

<script>
  import { numbersReading } from "../lib/numbers-ui.ts";
  import { todayIso } from "../lib/explain.ts";
  import { countReadingOf } from "../lib/reading-ui.ts";

  const form = document.querySelector<HTMLFormElement>("form.num-form")!;
  const out = document.querySelector<HTMLElement>("[data-results]")!;
  const articles = new Set<string>(JSON.parse(out.dataset.articles ?? "[]"));

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = (form.elements.namedItem("n") as HTMLInputElement).value.trim();
    const date = (form.elements.namedItem("d") as HTMLInputElement).value;
    if (!date) return;
    const hint = "Add your full birth name above to see your Expression, Soul Urge, Personality and Maturity numbers too.";
    out.innerHTML = numbersReading({ date, name, tier: "first", articles, today: todayIso(), noNameHint: hint });
    out.setAttribute("data-glossary", "");
    delete out.dataset.glossaryDone;
    document.dispatchEvent(new Event("glossary:scan"));
    out.scrollIntoView({ behavior: "smooth", block: "start" });
    // each new name and date counts once towards the reading counter
    countReadingOf(`numerology|${name.toLowerCase()}|${date}`);
  });
</script>
