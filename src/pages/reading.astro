---
// A reading, built in the visitor's browser from the details in the link.
// On your own: your Life Path in brief (the full numerology is on /reading/numbers),
// your Chinese animal and element, then your birth chart from BirthChart.astro.
// With a second person in the link: the relationship reading only.
import Base from "../layouts/Base.astro";
import BirthChart from "../components/BirthChart.astro";
import ShareReading from "../components/ShareReading.astro";
import DonationBox from "../components/DonationBox.astro";
import { getCollection } from "astro:content";
import "../styles/reading.css";

// Library article ids, so the working can link to an article only when it exists.
const articles = (await getCollection("library")).map((a) => a.id);
---

<Base title="Your reading">
  <section class="container reading" data-reading data-articles={JSON.stringify(articles)}>
    <noscript><p>Your reading is calculated in your browser, so please turn on JavaScript.</p></noscript>
  </section>
  <BirthChart />
  <ShareReading />
  <section class="container reading" data-reading-end></section>
  <section class="container" style="margin-top:64px">
    <DonationBox compact />
  </section>
</Base>

<script>
  import { lifePath } from "../lib/numerology.ts";
  import { chineseSign, secretFriendOf, clashOf, friendsOf } from "../lib/chinese.ts";
  import { GROUPS, ELEMENTS, PROFILES, seasonOf } from "../data/zodiac.ts";
  import { PLANET_BY_ID } from "../data/astrology.ts";
  import { PLACEMENTS } from "../data/placements.ts";
  import { PAIR_TITLES, PAIR_LINES, PAIR_SHORT, CHEMISTRY, type Tone } from "../data/synastry.ts";
  import { personalSigns, pairUp, chemistryOf } from "../lib/synastry.ts";
  import { NUMBER_MEANINGS, NUMBER_FAMILIES } from "../data/numbers.ts";
  import { KINDS, relationshipById } from "../data/relationships.ts";
  import { compare, comparisonBreakdown, elementLine, lifePathPairLine, yearTogetherLine } from "../lib/compat.ts";
  import { lifePathBreakdown, chineseBreakdowns, todayIso } from "../lib/explain.ts";
  import { esc, calc, countReading, soloQuery, isPartnerReading, type Tier } from "../lib/reading-ui.ts";

  const q = new URLSearchParams(location.search);
  const tier = (q.get("tier") ?? "first") as Tier;
  const name = (q.get("n") ?? "").trim();
  const date = q.get("d") ?? "";
  const root = document.querySelector<HTMLElement>("[data-reading]")!;
  const articles = new Set<string>(JSON.parse(root.dataset.articles ?? "[]"));
  /** Marks a section as a highlight the reader can tick in "Share your reading". */
  const share = (title: string, text: string) => ` data-share-title="${esc(title)}" data-share-text="${esc(text)}"`;
  const lc = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);

  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
    root.innerHTML = `<h1>Let's begin</h1><p>Please <a href="/">enter your birth date</a> to see your reading.</p>`;
  } else {
    root.innerHTML = isPartnerReading(q) ? relationship() : solo();
    root.setAttribute("data-glossary", "");
    document.dispatchEvent(new Event("glossary:scan"));
    countReading();
  }

  /** Your own reading: Life Path in brief, then your animal and element. The birth chart follows. */
  function solo() {
    const first = name.split(/\s+/)[0] || "friend";
    const tierName = { glance: "Quick Glance", first: "First Timers", deep: "Full Deep Dive" }[tier];
    document.querySelector<HTMLElement>("[data-reading-end]")!.innerHTML =
      `<p class="muted" style="margin-top:28px">PDF downloads are coming soon.</p>`;
    return `
      <p class="eyebrow">${tierName} reading</p>
      <h1>${esc(first)}, here is your reading</h1>
      ${tier === "first" ? `<p class="muted">Welcome! Your reading brings together numerology, the Chinese zodiac and your birth chart. Tap any underlined word for a quick explanation.</p>` : ""}
      ${lifePathStrip()}
      ${animalSection()}`;
  }

  function lifePathStrip() {
    const lp = lifePath(date);
    const m = NUMBER_MEANINGS[lp.value];
    return `
      <section class="part">
        <div class="panel lp-strip"${share(`Life Path ${lp.value}${m?.keyword ? `, ${m.keyword}` : ""}`, m?.essence ?? "")}>
          <span class="n">${lp.value}</span>
          <div>
            <span class="what">Your Life Path</span>
            <span class="k">${m?.keyword ?? ""}</span>
            <p class="muted">${m?.essence ?? ""} Your Life Path is the main number in numerology, worked out from your birth date.</p>
          </div>
          <a class="btn" href="/reading/numbers?${q.toString()}">Explore your numerology →</a>
        </div>
        ${calc([lifePathBreakdown(date)], articles)}
      </section>`;
  }

  function animalSection() {
    const cn = chineseSign(date);
    const g = GROUPS[cn.animal.group];
    const el = ELEMENTS[cn.element];
    const season = seasonOf(cn.animal.id);
    const friends = friendsOf(cn.animal.id).map((f) => f.name);
    const elementCard = `
      <div class="panel el-card">
        <p class="eyebrow">Your element</p>
        <h3>${el.glyph} What ${cn.element} brings to your ${cn.animal.name}</h3>
        ${tier === "glance" ? "" : `<p class="muted">Every year has one of five elements, and it colours the animal born in it. A ${cn.element} ${cn.animal.name} is a different character from, say, a ${cn.element === "Fire" ? "Water" : "Fire"} ${cn.animal.name}.</p>`}
        <p>${el.essence} ${el.personality}</p>
        ${tier === "glance" ? "" : `<dl>
          <dt>Strengths</dt><dd>${el.strengths}</dd>
          <dt>Watch out for</dt><dd>${el.watchOut}</dd>
          <dt>Season</dt><dd>${el.season}</dd>
          <dt>Planet</dt><dd>${el.planet}, the planet Chinese astrology links with ${cn.element}</dd>
        </dl>`}
      </div>`;
    const yinYang = `
      <div class="panel">
        <p class="eyebrow">${cn.yinYang}</p>
        <p>${cn.yinYang === "Yang"
          ? `You were born in a yang year: the bright, outgoing side of life. Yang ${cn.animal.name}s tend to act first and think later, and meet the world head on.`
          : `You were born in a yin year: the quiet, inward side of life. Yin ${cn.animal.name}s tend to watch first, feel deeply and act with care.`}</p>
        ${tier === "glance" ? "" : `<p class="muted">Your ${cn.animal.name} also belongs to ${season.season.toLowerCase()}, the season of ${season.meaning}.</p>`}
      </div>`;
    const wheel = `
      <div class="panel wheel-card">
        <p class="eyebrow">Your people on the wheel</p>
        <p><strong>Friend group, ${g.name}:</strong> the ${cn.animal.name}, ${friends.join(" and ")}. ${g.meaning}</p>
        ${tier === "glance" ? "" : `<p><strong>Secret friend:</strong> the ${secretFriendOf(cn.animal.id).name}, a quiet, loyal ally.</p>
        <p><strong>Clash:</strong> the ${clashOf(cn.animal.id).name}, directly opposite you: friction, and a chance to grow.</p>`}
      </div>`;
    if (tier === "first") {
      // First Timers: the same story in one panel, headline first, then the follow-on
      return `
      <section class="part">
        <div class="panel animal"${share(`${cn.element} ${cn.animal.name}`, cn.animal.summary)}>
          <img src="/animals/${cn.animal.id}.png" alt="" width="120" height="120">
          <div>
            <p class="eyebrow">Chinese zodiac</p>
            <h2>${cn.element} ${cn.animal.name}</h2>
            <ul class="chips">${cn.animal.traits.map((t) => `<li>${t}</li>`).join("")}</ul>
            <p>${cn.animal.summary}</p>
          </div>
        </div>
        <div class="panel says">
          <div class="say"><h3>${el.glyph} What ${cn.element} brings</h3>
            <p><strong>${el.strengths}</strong> ${el.personality} ${cn.yinYang === "Yang" ? `Born in a yang year, you tend to act first and meet the world head on.` : `Born in a yin year, you tend to watch first, feel deeply and act with care.`} Watch out for ${lc(el.watchOut)}</p></div>
          <div class="say"><h3>Your people on the wheel</h3>
            <p>You click with the ${friends.join(" and ")}, your ${g.name} friend group, and the ${secretFriendOf(cn.animal.id).name} is your secret friend, a quiet, loyal ally. The ${clashOf(cn.animal.id).name} sits opposite you: friction, and a chance to grow.</p></div>
        </div>
        ${calc(chineseBreakdowns(date), articles)}
      </section>`;
    }
    return `
      <section class="part">
        <div class="panel animal"${share(`${cn.element} ${cn.animal.name}`, cn.animal.summary)}>
          <img src="/animals/${cn.animal.id}.png" alt="" width="120" height="120">
          <div>
            <p class="eyebrow">Chinese zodiac</p>
            <h2>${cn.element} ${cn.animal.name}</h2>
            ${cn.animal.alsoKnownAs ? `<p class="muted"><em>${cn.animal.alsoKnownAs}</em></p>` : ""}
            <ul class="chips">${cn.animal.traits.map((t) => `<li>${t}</li>`).join("")}</ul>
            <p>${cn.animal.summary} You were born in the ${cn.zodiacYear} zodiac year, a ${cn.yinYang.toLowerCase()} year.</p>
          </div>
        </div>
        ${elementCard}
        <div class="pair">${yinYang}${wheel}</div>
        ${calc(chineseBreakdowns(date), articles)}
      </section>`;
  }

  /** The relationship reading, shown instead of the solo reading when a second person is in the link. */
  function relationship() {
    const rel = relationshipById(q.get("rel"))!;
    const date2 = q.get("d2")!;
    const kind = KINDS[rel.kind];
    const tone: Tone = rel.kind === "love" ? "love" : rel.kind === "friend" ? "friends" : ["boss", "colleague", "report", "mentor"].includes(rel.kind) ? "work" : "family";
    const myName = name.split(/\s+/)[0];
    const given = (q.get("n2") ?? "").trim().split(/\s+/)[0];
    const them = given ? esc(given) : rel.them;
    const Them = them.charAt(0).toUpperCase() + them.slice(1);
    const year = Number(todayIso().slice(0, 4));
    const c = compare(date, date2, year);
    const animalLine = kind.chinese[c.relation].replaceAll("{me}", c.me.sign.animal.name).replaceAll("{them}", c.them.sign.animal.name);
    const stars = "★".repeat(Math.floor(c.harmony)) + (c.harmony % 1 ? "½" : "");
    const fam = NUMBER_FAMILIES.find((f) => f.members.includes(c.me.lifePath));

    // both charts at midday (or at your birth time, if given) in this device's time zone
    const zone = Intl.DateTimeFormat().resolvedOptions().timeZone || "UTC";
    const timeIn = q.get("t") ?? "";
    const mine = personalSigns(date, /^\d{2}:\d{2}$/.test(timeIn) ? timeIn : "", zone);
    const theirs = personalSigns(date2, "", zone);
    const pairs = pairUp(mine, theirs);

    // where you click and where to take care, from every part of the comparison
    const click: string[] = [], care: string[] = [];
    for (const p of pairs) {
      if (p.feel === "easy") click.push(`<strong>${PAIR_TITLES[p.planet][tone]}:</strong> ${PAIR_SHORT[p.planet].easy}.`);
      if (p.feel === "care") care.push(`<strong>${PAIR_TITLES[p.planet][tone]}:</strong> ${PAIR_SHORT[p.planet].care}.`);
    }
    if (c.relation === "friend" || c.relation === "secret") click.push(`<strong>Your animals:</strong> the ${c.me.sign.animal.name} and ${c.them.sign.animal.name} are ${c.relation === "secret" ? "secret friends" : "in the same friend group"} on the zodiac wheel.`);
    if (c.relation === "clash") care.push(`<strong>Your animals:</strong> the ${c.me.sign.animal.name} and ${c.them.sign.animal.name} sit opposite each other on the wheel.`);
    if (c.element === "iFeed" || c.element === "theyFeed") click.push(`<strong>Your elements:</strong> ${c.element === "iFeed" ? `your ${c.me.sign.element} feeds ${them}'s ${c.them.sign.element}` : `${them}'s ${c.them.sign.element} feeds your ${c.me.sign.element}`}.`);
    if (c.element === "iGuide" || c.element === "theyGuide") care.push(`<strong>Your elements:</strong> ${c.element === "iGuide" ? `your ${c.me.sign.element} keeps ${them}'s ${c.them.sign.element} in check` : `${them}'s ${c.them.sign.element} keeps your ${c.me.sign.element} in check`}.`);
    if (c.sameFamily) click.push(`<strong>Your Life Paths:</strong> ${c.me.lifePath} and ${c.them.lifePath} share a family, so you want similar things from life.`);
    if (c.me.personalYear === c.them.personalYear) click.push(`<strong>This year:</strong> you are both in a Personal Year ${c.me.personalYear}, moving in step.`);
    const easiest = pairs.find((p) => p.link === "trine" || p.link === "same") ?? pairs.find((p) => p.feel === "easy");
    const hardest = pairs.find((p) => p.link === "square") ?? pairs.find((p) => p.feel === "care");

    const person = (who: string, p: typeof c.me, signs: typeof mine) => `
      <div class="panel who">
        <img src="/animals/${p.sign.animal.id}.png" alt="" width="64" height="64">
        <div>
          <p class="eyebrow">${who}</p>
          <p><strong>${signs.signs.sun.glyph} ${signs.signs.sun.name} Sun · ${p.sign.element} ${p.sign.animal.name}</strong><br>Moon in ${signs.signs.moon.name}${signs.unsure.moon ? " (best guess)" : ""} · Life Path ${p.lifePath}, ${NUMBER_MEANINGS[p.lifePath]?.keyword ?? ""}<br>Personal Year ${p.personalYear}</p>
        </div>
      </div>`;

    const block = (p: (typeof pairs)[number]) => {
      const planet = PLANET_BY_ID[p.planet];
      const pm = PLACEMENTS[p.planet][p.mine.id], pt = PLACEMENTS[p.planet][p.theirs.id];
      const u = theirs.unsure[p.planet] ?? mine.unsure[p.planet];
      const whose = theirs.unsure[p.planet] ? `${Them}'s` : "Your";
      return `
        <div class="say"${share(`${PAIR_TITLES[p.planet][tone]}: ${p.mine.name} meets ${p.theirs.name}`, PAIR_LINES[p.planet][p.link])}>
          <h3><span class="gl">${planet.glyph}</span>${PAIR_TITLES[p.planet][tone]}</h3>
          <p><span class="pl">Your ${planet.name} in ${p.mine.name}:</span> ${lc(pm.glance)}. <span class="pl">${Them}'s ${planet.name} in ${p.theirs.name}:</span> ${lc(pt.glance)}.</p>
          <p>${PAIR_LINES[p.planet][p.link]}</p>
          ${u ? `<p class="facts">${whose} ${planet.name} changed sign that day, from ${u.from.name} to ${u.to.name}, so without a birth time this one is a best guess.</p>` : ""}
        </div>`;
    };
    const chemistry = tone === "love"
      ? `<div class="say"><h3><span class="gl">♀\uFE0E♂\uFE0E</span>Chemistry</h3>
          <p>${CHEMISTRY[chemistryOf(mine.signs.venus, theirs.signs.mars)].replace("{V}", "Your").replace("{M}", `${them}'s`)}</p>
          <p>${CHEMISTRY[chemistryOf(theirs.signs.venus, mine.signs.mars)].replace("{V}", `${Them}'s`).replace("{M}", "your")}</p>
        </div>`
      : "";
    const profile = (id: string) => PROFILES[id]?.[tone === "love" ? "love" : tone === "work" ? "work" : "strengths"] ?? "";

    document.querySelector<HTMLElement>("[data-reading-end]")!.innerHTML = `
      <p class="back" style="margin-top:28px">Want the full picture of yourself too? <a href="/reading?${soloQuery(q)}">See your own reading</a></p>`;
    return `
      <section class="compat">
        <p class="eyebrow">${rel.label} compatibility</p>
        <h1>${!given ? rel.bond : rel.bond.includes(rel.them) ? rel.bond.replace(rel.them, them) : `${rel.bond} with ${them}`}</h1>
        <p>${kind.intro}</p>
        <div class="panel harmony"${share(`${rel.label} harmony: ${c.harmony} of 5`, [easiest ? `Our easiest link is ${PAIR_TITLES[easiest.planet][tone].toLowerCase()}.` : "", hardest ? `Our biggest lesson is ${PAIR_TITLES[hardest.planet][tone].toLowerCase()}.` : ""].join(" ").trim())}>
          <p class="eyebrow">Your harmony</p>
          <p class="stars" aria-label="${c.harmony} out of 5">${stars}<span class="muted"> ${c.harmony} of 5</span></p>
          ${easiest || hardest ? `<p>${easiest ? `Your easiest link is <strong>${PAIR_TITLES[easiest.planet][tone].toLowerCase()}</strong>.` : ""} ${hardest ? `Your biggest lesson is <strong>${PAIR_TITLES[hardest.planet][tone].toLowerCase()}</strong>.` : ""}</p>` : ""}
          ${calc([comparisonBreakdown(c, given || rel.them)], articles, "How we scored it")}
        </div>
        <div class="pair">${person(myName ? esc(myName) : "You", c.me, mine)}${person(given ? them : rel.label, c.them, theirs)}</div>
        <div class="pair">
          <div class="panel"><p class="eyebrow">Where you click</p>${click.length ? `<ul>${click.map((x) => `<li>${x}</li>`).join("")}</ul>` : `<p>No part of your charts is an automatic match, so this is a bond you build by choice, and those are often the strongest.</p>`}</div>
          <div class="panel"><p class="eyebrow">Where to take care</p>${care.length ? `<ul>${care.map((x) => `<li>${x}</li>`).join("")}</ul>` : `<p>Nothing in your charts pulls hard against the other. Your main job is not to take the ease for granted.</p>`}</div>
        </div>
        <section class="part">
          <h2>Planet by planet</h2>
          <p class="muted">Each planet is one part of a person. Here is how each part of you meets the same part of ${them}.</p>
          <div class="panel says">${pairs.map(block).join("")}${chemistry}</div>
        </section>
        <section class="part">
          <h2>Your animals and elements</h2>
          <div class="panel says">
            <div class="say"${share(`${c.me.sign.element} ${c.me.sign.animal.name} and ${c.them.sign.element} ${c.them.sign.animal.name}`, animalLine)}><h3>${c.me.sign.element} ${c.me.sign.animal.name} and ${c.them.sign.element} ${c.them.sign.animal.name}</h3>
              <p>${animalLine}</p>
              ${profile(c.me.sign.animal.id) ? `<p><span class="pl">Your ${c.me.sign.animal.name}:</span> ${lc(profile(c.me.sign.animal.id))} <span class="pl">${Them}'s ${c.them.sign.animal.name}:</span> ${lc(profile(c.them.sign.animal.id))}</p>` : ""}</div>
            <div class="say"><h3>${ELEMENTS[c.me.sign.element].glyph} ${c.me.sign.element} meets ${ELEMENTS[c.them.sign.element].glyph} ${c.them.sign.element}</h3>
              <p>${elementLine(c.me.sign.element, c.them.sign.element, them)}</p></div>
          </div>
        </section>
        <section class="part">
          <h2>Your numbers</h2>
          <div class="panel says">
            <div class="say"${share(`Life Path ${c.me.lifePath} and Life Path ${c.them.lifePath}`, c.sameFamily ? kind.numbers.same : kind.numbers.different)}><h3>Life Path ${c.me.lifePath} and Life Path ${c.them.lifePath}</h3>
              <p>${lifePathPairLine(c.me.lifePath, c.them.lifePath, them)} ${c.sameFamily ? kind.numbers.same : kind.numbers.different}${c.sameFamily && fam ? ` You are both ${fam.name}.` : ""}</p></div>
            <div class="say"><h3>This year together</h3>
              <p>${yearTogetherLine(c.me.personalYear, c.them.personalYear, them)}</p></div>
          </div>
        </section>
        <div class="panel tips"><p class="eyebrow">Tips for your bond</p><ul>${kind.tips.map((t) => `<li>${t}</li>`).join("")}</ul></div>
      </section>`;
  }
</script>
