---
// Shown for any address that doesn't exist. Cloudflare Pages uses it automatically.
import Base from "../layouts/Base.astro";
---

<Base title="Lost among the stars">
  <section class="container" style="padding-top:64px;max-width:760px">
    <p class="eyebrow">404</p>
    <h1>Lost among the stars</h1>
    <p>We couldn't find that page. It may have moved, or the link may have a typo.</p>
    <p><a class="btn" href="/">Back to the homepage</a></p>
  </section>
</Base>
