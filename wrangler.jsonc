// Cloudflare Workers settings. worker/index.ts answers /api/* and hands every
// other request to the built site in ./dist.
{
  "name": "starlight",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Show src/pages/404.astro for addresses that don't exist.
    "not_found_handling": "404-page"
  },
  // The database behind the reading counter and the Share your thoughts messages.
  "d1_databases": [
    {
      "binding": "COUNTER_DB",
      "database_name": "starlight-counter",
      "database_id": "98755a1b-956c-49a2-aae5-14076fbab2ed",
      "migrations_dir": "migrations"
    }
  ],
  // Lets Cloudflare build a preview link for each pull request.
  "previews": {}
}
